+#if REX_PLATFORM_ANDROID && defined(__aarch64__)
+
+// rex_fiber_switch(void** save_sp, void* load_sp): pushes the callee-saved registers (AAPCS64:
+// x19-x30, d8-d15) on the current stack, stores the stack pointer to *save_sp, then loads load_sp
+// and pops the same frame from it. A new fiber's frame holds Fiber::Trampoline as its return
+// address, so the first switch to it "returns" into the trampoline.
+extern "C" void rex_fiber_switch(void** save_sp, void* load_sp);
+asm(R"(
+  .text
+  .p2align 4
+  .globl rex_fiber_switch
+  .hidden rex_fiber_switch
+  .type rex_fiber_switch, %function
+rex_fiber_switch:
+  sub sp, sp, #160
+  stp x19, x20, [sp, #0]
+  stp x21, x22, [sp, #16]
+  stp x23, x24, [sp, #32]
+  stp x25, x26, [sp, #48]
+  stp x27, x28, [sp, #64]
+  stp x29, x30, [sp, #80]
+  stp d8, d9, [sp, #96]
+  stp d10, d11, [sp, #112]
+  stp d12, d13, [sp, #128]
+  stp d14, d15, [sp, #144]
+  mov x9, sp
+  str x9, [x0]
+  mov sp, x1
+  ldp x19, x20, [sp, #0]
+  ldp x21, x22, [sp, #16]
+  ldp x23, x24, [sp, #32]
+  ldp x25, x26, [sp, #48]
+  ldp x27, x28, [sp, #64]
+  ldp x29, x30, [sp, #80]
+  ldp d8, d9, [sp, #96]
+  ldp d10, d11, [sp, #112]
+  ldp d12, d13, [sp, #128]
+  ldp d14, d15, [sp, #144]
+  add sp, sp, #160
+  ret
+  .size rex_fiber_switch, .-rex_fiber_switch
+)");
+
+namespace {
+constexpr size_t kSwitchFrameSize = 160;
+constexpr size_t kSwitchFrameLinkRegister = 88;  // x30 slot
+}  // namespace
+
+Fiber* Fiber::ConvertCurrentThread() {
+  // The thread's own stack pointer is saved by the first SwitchTo away from it.
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+  auto top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size()) & ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint8_t*>(top - kSwitchFrameSize);
+  std::memset(frame, 0, kSwitchFrameSize);  // x29 = 0 ends frame-pointer stack walks here.
+  auto trampoline = reinterpret_cast<uintptr_t>(&Fiber::Trampoline);
+  std::memcpy(frame + kSwitchFrameLinkRegister, &trampoline, sizeof(trampoline));
+  f->stack_pointer_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber entry must switch away instead of returning (as with uc_link = nullptr).
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->stack_pointer_, target->stack_pointer_);
+}
