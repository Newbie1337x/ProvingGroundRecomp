+
+namespace rex {
+
+/// The device's API level (android_get_device_api_level), cached after the first call.
+int GetAndroidApiLevel();
+
+/// Runs the Android setup of the memory, thread and file system layers. SDL's activity calls
+/// SDL_main on its own thread with no Xenia-style JNI entry point, so the SDL entry point calls
+/// this before the app starts.
+void InitializeAndroid();
+void ShutdownAndroid();
+
+}  // namespace rex
+
