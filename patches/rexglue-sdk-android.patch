+void VulkanPipelineCache::LoadVulkanPipelineCache(const std::filesystem::path& path) {
+  if (vulkan_pipeline_cache_ != VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  std::vector<uint8_t> data;
+  if (FILE* file = rex::filesystem::OpenFile(path, "rb")) {
+    fseek(file, 0, SEEK_END);
+    long size = ftell(file);
+    fseek(file, 0, SEEK_SET);
+    if (size > 0) {
+      data.resize(size_t(size));
+      if (fread(data.data(), 1, data.size(), file) != data.size()) {
+        data.clear();
+      }
+    }
+    fclose(file);
+  }
+  VkPipelineCacheCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  // The driver checks the header (vendor, device, cache UUID) and ignores data it cannot use.
+  create_info.initialDataSize = data.size();
+  create_info.pInitialData = data.empty() ? nullptr : data.data();
+  VkResult result =
+      dfn.vkCreatePipelineCache(device, &create_info, nullptr, &vulkan_pipeline_cache_);
+  if (result != VK_SUCCESS && !data.empty()) {
+    create_info.initialDataSize = 0;
+    create_info.pInitialData = nullptr;
+    result = dfn.vkCreatePipelineCache(device, &create_info, nullptr, &vulkan_pipeline_cache_);
+  }
+  if (result != VK_SUCCESS) {
+    vulkan_pipeline_cache_ = VK_NULL_HANDLE;
+    REXGPU_WARN("VulkanPipelineCache: vkCreatePipelineCache failed ({})", int(result));
+    return;
+  }
+  vulkan_pipeline_cache_path_ = path;
+  REXGPU_INFO("VulkanPipelineCache: driver pipeline cache {} ({} bytes loaded)",
+              rex::path_to_utf8(path), data.size());
+}
+
+void VulkanPipelineCache::SaveVulkanPipelineCache() {
+  if (vulkan_pipeline_cache_ == VK_NULL_HANDLE || vulkan_pipeline_cache_path_.empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(device, vulkan_pipeline_cache_, &size, nullptr) != VK_SUCCESS ||
+      !size) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  VkResult result = dfn.vkGetPipelineCacheData(device, vulkan_pipeline_cache_, &size, data.data());
+  if ((result != VK_SUCCESS && result != VK_INCOMPLETE) || !size) {
+    return;
+  }
+  // Write a temporary file and rename it, so a kill mid-write keeps the previous cache.
+  std::filesystem::path temp_path = vulkan_pipeline_cache_path_;
+  temp_path += ".tmp";
+  FILE* file = rex::filesystem::OpenFile(temp_path, "wb");
+  if (!file) {
+    return;
+  }
+  bool written = fwrite(data.data(), 1, size, file) == size;
+  written = (fclose(file) == 0) && written;
+  std::error_code ec;
+  if (written) {
+    std::filesystem::rename(temp_path, vulkan_pipeline_cache_path_, ec);
+  } else {
+    std::filesystem::remove(temp_path, ec);
+  }
+}
