+VkDescriptorSet VulkanCommandProcessor::AllocateNativeTextureSet(VkDescriptorSetLayout layout) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (uint32_t attempt = 0; attempt < 2; ++attempt) {
+    if (native_texture_set_pool_ != VK_NULL_HANDLE) {
+      VkDescriptorSetAllocateInfo allocate_info = {};
+      allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+      allocate_info.descriptorPool = native_texture_set_pool_;
+      allocate_info.descriptorSetCount = 1;
+      allocate_info.pSetLayouts = &layout;
+      VkDescriptorSet set;
+      if (dfn.vkAllocateDescriptorSets(device, &allocate_info, &set) == VK_SUCCESS) {
+        return set;
+      }
+      // Full: reset once the frames that may use its sets are completed; every kept set is
+      // from this pool, so all of them are made again.
+      native_texture_set_pools_retired_.emplace_back(frame_current_, native_texture_set_pool_);
+      native_texture_set_pool_ = VK_NULL_HANDLE;
+      ++native_texture_set_epoch_;
+      ++native_texture_set_stats_[2];
+    }
+    if (!native_texture_set_pools_free_.empty()) {
+      native_texture_set_pool_ = native_texture_set_pools_free_.back();
+      native_texture_set_pools_free_.pop_back();
+      continue;
+    }
+    constexpr uint32_t kSetsPerPool = 16384;
+    VkDescriptorPoolSize pool_sizes[2];
+    pool_sizes[0].type = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    pool_sizes[0].descriptorCount = kSetsPerPool * 4;
+    pool_sizes[1].type = VK_DESCRIPTOR_TYPE_SAMPLER;
+    pool_sizes[1].descriptorCount = kSetsPerPool * 4;
+    VkDescriptorPoolCreateInfo pool_create_info = {};
+    pool_create_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    pool_create_info.maxSets = kSetsPerPool;
+    pool_create_info.poolSizeCount = 2;
+    pool_create_info.pPoolSizes = pool_sizes;
+    if (dfn.vkCreateDescriptorPool(device, &pool_create_info, nullptr, &native_texture_set_pool_) !=
+        VK_SUCCESS) {
+      native_texture_set_pool_ = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+    }
+  }
+  return VK_NULL_HANDLE;
+}
+
+void VulkanCommandProcessor::DestroyNativeTextureSetPools() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (native_texture_set_pool_ != VK_NULL_HANDLE) {
+    dfn.vkDestroyDescriptorPool(device, native_texture_set_pool_, nullptr);
+    native_texture_set_pool_ = VK_NULL_HANDLE;
+  }
+  for (VkDescriptorPool pool : native_texture_set_pools_free_) {
+    dfn.vkDestroyDescriptorPool(device, pool, nullptr);
+  }
+  native_texture_set_pools_free_.clear();
+  for (const auto& retired : native_texture_set_pools_retired_) {
+    dfn.vkDestroyDescriptorPool(device, retired.second, nullptr);
+  }
+  native_texture_set_pools_retired_.clear();
+  ++native_texture_set_epoch_;
+}
+
+void VulkanCommandProcessor::DestroyConstantsDynamicDescriptorSets() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  constants_dynamic_descriptor_sets_.clear();
+  for (VkDescriptorPool pool : constants_dynamic_descriptor_pools_) {
+    dfn.vkDestroyDescriptorPool(device, pool, nullptr);
+  }
+  constants_dynamic_descriptor_pools_.clear();
+  constants_dynamic_descriptor_pool_sets_left_ = 0;
+}
