+  // whether the work was queued.
+  bool RunInQueueOrder(std::function<void()> work) const {
+    QueueOrdering* queue_ordering = queue_ordering_.load(std::memory_order_acquire);
+    if (!queue_ordering) {
+      return false;
+    }
+    queue_ordering->Enqueue(std::move(work));
+    return true;
+  }
