+void VulkanTextureCache::CaptureUsedTextures(uint32_t used_texture_mask,
+                                             std::vector<void*>& textures_out) const {
+  textures_out.clear();
+  uint32_t textures_remaining = used_texture_mask;
+  uint32_t index;
+  while (rex::bit_scan_forward(textures_remaining, &index)) {
+    textures_remaining &= ~(uint32_t(1) << index);
+    const TextureBinding* binding = GetValidTextureBinding(index);
+    if (!binding) {
+      continue;
+    }
+    if (binding->texture) {
+      textures_out.push_back(binding->texture);
+    }
+    if (binding->texture_signed) {
+      textures_out.push_back(binding->texture_signed);
+    }
+  }
+}
