+void VulkanRenderTargetCache::CopyDepthRenderTargetRectangles(
+    RenderTarget* source, RenderTarget* dest, const Transfer::Rectangle* rectangles,
+    uint32_t rectangle_count) {
+  auto& source_rt = *static_cast<VulkanRenderTarget*>(source);
+  auto& dest_rt = *static_cast<VulkanRenderTarget*>(dest);
+  const RenderTargetKey source_key = source_rt.key();
+  const RenderTargetKey dest_key = dest_rt.key();
+  const uint32_t source_scale = GetKeyScaleXSixteenths(source_key);
+  const uint32_t dest_scale = GetKeyScaleXSixteenths(dest_key);
+  VkPipeline pipeline =
+      GetOwnScaleDepthCopyPipeline(dest_key.GetDepthFormat(), source_scale, dest_scale);
+  if (pipeline == VK_NULL_HANDLE) {
+    return;
+  }
+  RenderPassKey render_pass_key;
+  render_pass_key.msaa_samples = dest_key.msaa_samples;
+  render_pass_key.depth_and_color_used = 0b1;
+  render_pass_key.depth_format = dest_key.GetDepthFormat();
+  VkRenderPass render_pass = GetHostRenderTargetsRenderPass(render_pass_key);
+  const RenderTarget* framebuffer_render_targets[1 + xenos::kMaxColorRenderTargets] = {};
+  framebuffer_render_targets[0] = dest;
+  const Framebuffer* framebuffer = GetHostRenderTargetsFramebuffer(
+      render_pass_key, dest_key.pitch_tiles_at_32bpp, framebuffer_render_targets);
+  if (render_pass == VK_NULL_HANDLE || !framebuffer) {
+    return;
+  }
+  const uint64_t current_submission = command_processor_.GetCurrentSubmission();
+  VkBuffer vertex_buffer;
+  VkDeviceSize vertex_buffer_offset;
+  float* vertices = reinterpret_cast<float*>(transfer_vertex_buffer_pool_->Request(
+      current_submission, sizeof(float) * 2 * 6 * rectangle_count, sizeof(float), vertex_buffer,
+      vertex_buffer_offset));
+  if (!vertices) {
+    return;
+  }
+  const float pixels_to_ndc_x =
+      2.0f * float(dest_scale) / (16.0f * float(framebuffer->host_extent.width));
+  const float pixels_to_ndc_y =
+      2.0f * float(GetKeyScaleYSixteenths(dest_key)) /
+      (16.0f * float(framebuffer->host_extent.height));
+  for (uint32_t i = 0; i < rectangle_count; ++i) {
+    const Transfer::Rectangle& rectangle = rectangles[i];
+    const float x0 = -1.0f + float(rectangle.x_pixels) * pixels_to_ndc_x;
+    const float y0 = -1.0f + float(rectangle.y_pixels) * pixels_to_ndc_y;
+    const float x1 = x0 + float(rectangle.width_pixels) * pixels_to_ndc_x;
+    const float y1 = y0 + float(rectangle.height_pixels) * pixels_to_ndc_y;
+    const float rectangle_vertices[] = {x0, y0, x0, y1, x1, y0, x1, y0, x0, y1, x1, y1};
+    std::memcpy(vertices, rectangle_vertices, sizeof(rectangle_vertices));
+    vertices += rex::countof(rectangle_vertices);
+  }
+
+  const VkImageSubresourceRange depth_stencil_range = ui::vulkan::util::InitializeSubresourceRange(
+      VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+  command_processor_.PushImageMemoryBarrier(
+      source_rt.image(), depth_stencil_range, source_rt.current_stage_mask(),
+      VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, source_rt.current_access_mask(),
+      VK_ACCESS_SHADER_READ_BIT, source_rt.current_layout(),
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  source_rt.SetUsage(VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  VkPipelineStageFlags dest_stage_mask;
+  VkAccessFlags dest_access_mask;
+  VkImageLayout dest_layout;
+  dest_rt.GetDrawUsage(&dest_stage_mask, &dest_access_mask, &dest_layout);
+  command_processor_.PushImageMemoryBarrier(
+      dest_rt.image(), depth_stencil_range, dest_rt.current_stage_mask(), dest_stage_mask,
+      dest_rt.current_access_mask(), dest_access_mask, dest_rt.current_layout(), dest_layout);
+  dest_rt.SetUsage(dest_stage_mask, dest_access_mask, dest_layout);
+  command_processor_.SubmitBarriersAndEnterRenderTargetCacheRenderPass(
+      render_pass, framebuffer, dest_rt.view_depth_stencil(), true);
+
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  VkViewport viewport;
+  viewport.x = 0.0f;
+  viewport.y = 0.0f;
+  viewport.width = float(framebuffer->host_extent.width);
+  viewport.height = float(framebuffer->host_extent.height);
+  viewport.minDepth = 0.0f;
+  viewport.maxDepth = 1.0f;
+  command_processor_.SetViewport(viewport);
+  VkRect2D scissor;
+  scissor.offset.x = 0;
+  scissor.offset.y = 0;
+  scissor.extent = framebuffer->host_extent;
+  command_processor_.SetScissor(scissor);
+  command_processor_.BindExternalGraphicsPipeline(pipeline);
+  VkDescriptorSet source_descriptor_set = source_rt.GetDescriptorSetTransferSource();
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                         own_scale_depth_copy_pipeline_layout_, 0, 1,
+                                         &source_descriptor_set, 0, nullptr);
+  command_buffer.CmdVkBindVertexBuffers(0, 1, &vertex_buffer, &vertex_buffer_offset);
+  command_buffer.CmdVkDraw(6 * rectangle_count, 1, 0, 0);
+  if (command_processor_.IsGpuTimingSequenceActive()) {
+    command_processor_.GpuTimingSequence(
+        fmt::format("own scale depth copy {} -> {}, {} rectangles", source_key.GetDebugName(),
+                    dest_key.GetDebugName(), rectangle_count));
+  }
+}
+
+void VulkanRenderTargetCache::PerformTransfersAndResolveClearsOwnScale(
+    uint32_t render_target_count, RenderTarget* const* render_targets,
+    const std::vector<Transfer>* render_target_transfers,
+    const uint64_t* render_target_resolve_clear_values,
+    const Transfer::Rectangle* resolve_clear_rectangle) {
+  bool any_own_scale = false;
+  for (uint32_t i = 0; i < render_target_count && !any_own_scale; ++i) {
+    if (!render_targets[i]) {
+      continue;
+    }
+    if (render_targets[i]->key().own_scale_sixteenths && !render_target_transfers[i].empty()) {
+      any_own_scale = true;
+      break;
+    }
+    for (const Transfer& transfer : render_target_transfers[i]) {
+      if (transfer.source->key().own_scale_sixteenths ||
+          (transfer.host_depth_source &&
+           transfer.host_depth_source->key().own_scale_sixteenths)) {
+        any_own_scale = true;
+        break;
+      }
+    }
+  }
+  if (!any_own_scale) {
+    PerformTransfersAndResolveClears(render_target_count, render_targets, render_target_transfers,
+                                     render_target_resolve_clear_values, resolve_clear_rectangle);
+    return;
+  }
+  assert_true(render_target_count <= 1 + xenos::kMaxColorRenderTargets);
+
+  Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithCutout];
+
+  // Sources with their own scale: blitted into their twins, which the transfers read.
+  for (uint32_t i = 0; i < render_target_count; ++i) {
+    own_scale_transfers_[i].clear();
+    if (!render_targets[i]) {
+      continue;
+    }
+    own_scale_transfers_[i] = render_target_transfers[i];
+    for (Transfer& transfer : own_scale_transfers_[i]) {
+      RenderTarget** sources[] = {&transfer.source, &transfer.host_depth_source};
+      for (RenderTarget** source_ptr : sources) {
+        RenderTarget* source = *source_ptr;
+        if (!source || !source->key().own_scale_sixteenths) {
+          continue;
+        }
+        RenderTarget* twin = GetUnscaledTwin(source);
+        if (!twin) {
+          continue;
+        }
+        RenderTargetKey source_key = source->key();
+        uint32_t rectangle_count = Transfer::GetRangeRectangles(
+            transfer.start_tiles, transfer.end_tiles, source_key.base_tiles,
+            source_key.GetPitchTiles(), source_key.msaa_samples, source_key.Is64bpp(), rectangles);
+        BlitRenderTargetRectangles(source, twin, rectangles, rectangle_count);
+        *source_ptr = twin;
+      }
+    }
+    // A destination that is the twin of the source has the data now.
+    RenderTarget* dest = render_targets[i];
+    own_scale_transfers_[i].erase(
+        std::remove_if(own_scale_transfers_[i].begin(), own_scale_transfers_[i].end(),
+                       [dest](const Transfer& transfer) { return transfer.source == dest; }),
+        own_scale_transfers_[i].end());
+  }
+
+  // Destinations with their own scale: the transfers are made in their twins, then blitted.
+  RenderTarget* twins[1 + xenos::kMaxColorRenderTargets] = {};
+  bool any_twin_transfers = false;
+  for (uint32_t i = 0; i < render_target_count; ++i) {
+    own_scale_twin_transfers_[i].clear();
+    RenderTarget* dest = render_targets[i];
+    if (!dest || !dest->key().own_scale_sixteenths || own_scale_transfers_[i].empty()) {
+      continue;
+    }
+    RenderTarget* twin = GetUnscaledTwin(dest);
+    if (!twin) {
+      continue;
+    }
+    twins[i] = twin;
+    for (Transfer transfer : own_scale_transfers_[i]) {
+      if (transfer.source == twin) {
+        // Already in the twin (the global-scale render target owned the range).
+        continue;
+      }
+      own_scale_twin_transfers_[i].push_back(transfer);
+      any_twin_transfers = true;
+    }
+  }
+  if (any_twin_transfers) {
+    PerformTransfersAndResolveClears(render_target_count, twins, own_scale_twin_transfers_);
+  }
+  for (uint32_t i = 0; i < render_target_count; ++i) {
+    if (!twins[i]) {
+      continue;
+    }
+    RenderTargetKey dest_key = render_targets[i]->key();
+    for (const Transfer& transfer : own_scale_transfers_[i]) {
+      uint32_t rectangle_count =
+          transfer.GetRectangles(dest_key.base_tiles, dest_key.GetPitchTiles(),
+                                 dest_key.msaa_samples, dest_key.Is64bpp(), rectangles,
+                                 resolve_clear_rectangle);
+      BlitRenderTargetRectangles(twins[i], render_targets[i], rectangles, rectangle_count);
+    }
+    own_scale_transfers_[i].clear();
+  }
+
+  PerformTransfersAndResolveClears(render_target_count, render_targets, own_scale_transfers_,
+                                   render_target_resolve_clear_values, resolve_clear_rectangle);
+}
