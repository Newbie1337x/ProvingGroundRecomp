diff --git a/include/rex/graphics/native_ranges.h b/include/rex/graphics/native_ranges.h
new file mode 100644
index 0000000..6d14719
--- /dev/null
+++ b/include/rex/graphics/native_ranges.h
@@ -0,0 +1,44 @@
+#pragma once
+
+// Guest memory ranges that a game's own renderer hooks know hold static data: vertex and
+// index buffers of meshes that are uploaded once and drawn from every frame. A command
+// processor may trust a range once it has requested it, instead of checking it on every
+// draw (gpu_trust_native_ranges).
+//
+// Addresses are guest physical. Registration is from any thread.
+#include <cstdint>
+
+namespace rex::graphics::native_ranges {
+
+// Registers [start, start + length) as static data, replacing every range it overlaps.
+// Registering again (new data at the same place) gives the range a new generation, so it is
+// requested again before it is trusted.
+// Index data (is_index) is forgotten when the CPU writes into it; vertex data is marked dirty
+// (IsDirty) and stays registered.
+void Register(uint32_t start, uint32_t length, bool is_index = false);
+// Forgets every registered range that overlaps [start, start + length).
+void Unregister(uint32_t start, uint32_t length);
+// The CPU wrote [start, start + length) (a watched page faulted, a file was read into it), so a
+// trusted range there must not be drawn from without requesting it again: vertex ranges are
+// marked dirty (the command processor requests them again and clears the mark), index ranges
+// are forgotten (their conversions are kept by generation; the game registers them again when
+// it draws them). Cheap when no range was ever registered in those pages.
+void InvalidateWritten(uint32_t start, uint32_t length, bool exact = false);
+// Whether the CPU wrote into the vertex range of this generation since ClearDirty.
+bool IsDirty(uint32_t generation);
+// Called before requesting the range again (a write after it marks it again).
+void ClearDirty(uint32_t generation);
+// Diagnostics: ranges forgotten by InvalidateWritten, by exact (file reads) and page-fault
+// writes, and a few recent (written start, forgotten range start) pairs.
+void GetInvalidationStats(uint64_t counts_out[2], uint32_t samples_out[16][2]);
+// The generation (unique, nonzero) of the registered range that contains
+// [start, start + length), or 0 if none does.
+uint32_t Lookup(uint32_t start, uint32_t length);
+// Number of registered ranges.
+uint32_t Count();
+// Changes whenever a registered range is replaced or forgotten (so a range found earlier may
+// be gone), and whenever any range is registered (so a range not found earlier may exist).
+uint32_t RemovalVersion();
+uint32_t ChangeVersion();
+
+}  // namespace rex::graphics::native_ranges
