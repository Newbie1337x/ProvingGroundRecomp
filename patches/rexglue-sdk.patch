+void* VulkanPrimitiveProcessor::RequestPersistentConvertedIndexBuffer(
+    xenos::IndexFormat format, uint32_t index_count, uint32_t coalignment_original_address,
+    size_t& persistent_handle_out) {
+  const VkDeviceSize index_size =
+      format == xenos::IndexFormat::kInt16 ? sizeof(uint16_t) : sizeof(uint32_t);
+  // Room for co-alignment with the guest indices.
+  const VkDeviceSize size =
+      index_size * index_count + XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE + sizeof(uint32_t);
+  if (size > kPersistentIndexChunkSize) {
+    return nullptr;
+  }
+  if (persistent_index_chunks_.empty() ||
+      persistent_index_chunks_.back().used + size > kPersistentIndexChunkSize) {
+    if (persistent_index_chunks_.size() >= kMaxPersistentIndexChunks) {
+      return nullptr;
+    }
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+    const VkDevice device = vulkan_device->device();
+    PersistentIndexChunk chunk;
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+            vulkan_device, kPersistentIndexChunkSize, VK_BUFFER_USAGE_INDEX_BUFFER_BIT,
+            ui::vulkan::util::MemoryPurpose::kUpload, chunk.buffer, chunk.memory,
+            &chunk.memory_type)) {
+      REXGPU_ERROR("Vulkan primitive processor: Failed to create a static index buffer chunk");
+      return nullptr;
+    }
+    void* mapping;
+    if (dfn.vkMapMemory(device, chunk.memory, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, chunk.buffer);
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, chunk.memory);
+      return nullptr;
+    }
+    chunk.mapping = static_cast<uint8_t*>(mapping);
+    persistent_index_chunks_.push_back(chunk);
+  }
+  PersistentIndexChunk& chunk = persistent_index_chunks_.back();
+  VkDeviceSize offset = (chunk.used + index_size - 1) & ~(index_size - 1);
+  uint8_t* mapping = chunk.mapping + offset;
+  ptrdiff_t coalignment_offset = GetSimdCoalignmentOffset(mapping, coalignment_original_address);
+  mapping += coalignment_offset;
+  offset = VkDeviceSize(offset + coalignment_offset);
+  chunk.used = offset + index_size * index_count;
+  chunk.written = true;
+  persistent_handle_out = persistent_index_buffers_.size();
+  persistent_index_buffers_.emplace_back(chunk.buffer, offset);
+  return mapping;
+}
+
+size_t VulkanPrimitiveProcessor::UsePersistentConvertedIndexBuffer(size_t persistent_handle) {
+  if (persistent_handle >= persistent_index_buffers_.size()) {
+    return SIZE_MAX;
+  }
+  size_t handle = frame_index_buffers_.size();
+  frame_index_buffers_.push_back(persistent_index_buffers_[persistent_handle]);
+  return handle;
+}
+
 }  // namespace rex::graphics::vulkan
