+  }
+  deferred_command_buffer_.CmdVkResetQueryPool(gpu_timing_pool_, slot * kGpuTimingQueriesPerFrame,
+                                               kGpuTimingQueriesPerFrame);
+  gpu_timing_slot_ = slot;
+  gpu_timing_counts_[slot] = 0;
+  gpu_timing_draws_[slot] = 0;
