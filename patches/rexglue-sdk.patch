+void VulkanCommandProcessor::NativeDrawCensus(const VulkanShader* vertex_shader,
+                                              const VulkanShader* pixel_shader,
+                                              VkPipeline pipeline, uint32_t used_texture_mask,
+                                              const IndexBufferInfo* index_buffer_info,
+                                              uint32_t index_count) {
+  constexpr size_t kMaxStates = 16;
+  ++native_census_draws_;
+  NativeMaterialCount& material = native_materials_[{
+      vertex_shader->ucode_data_hash(), pixel_shader ? pixel_shader->ucode_data_hash() : 0}];
+  ++material.draws;
+  material.vs_dwords = vertex_shader->ucode_dword_count();
+  material.ps_dwords = pixel_shader ? pixel_shader->ucode_dword_count() : 0;
+  const RegisterFile& regs = *register_file_;
+  // The first vertex fetch constant the vertex shader uses is the mesh's vertex buffer.
+  const Shader::ConstantRegisterMap& constant_map = vertex_shader->constant_register_map();
+  uint32_t vfetch_index = UINT32_MAX;
+  for (uint32_t i = 0; i < rex::countof(constant_map.vertex_fetch_bitmap); ++i) {
+    uint32_t bit;
+    if (rex::bit_scan_forward(constant_map.vertex_fetch_bitmap[i], &bit)) {
+      vfetch_index = i * 32 + bit;
+      break;
+    }
+  }
+  if (vfetch_index == UINT32_MAX) {
+    return;
+  }
+  const uint32_t vb_start = regs.GetVertexFetch(vfetch_index).address << 2;
+  auto hit_it = native_range_hits_.find(vb_start);
+  if (hit_it == native_range_hits_.end()) {
+    return;
+  }
+  ++native_census_mesh_draws_;
+  ++material.mesh_draws;
+  NativeDrawItemKey key;
+  key.vb = vb_start;
+  key.ib = index_buffer_info ? index_buffer_info->guest_base : 0;
+  key.count = index_count;
+  NativeDrawItem& item = native_draw_items_[key];
+  ++item.draws;
+  NativeDrawState state;
+  state.vertex_shader = vertex_shader->ucode_data_hash();
+  state.pixel_shader = pixel_shader ? pixel_shader->ucode_data_hash() : 0;
+  state.pipeline = uint64_t(reinterpret_cast<uintptr_t>(pipeline));
+  uint64_t textures = UINT64_C(0xCBF29CE484222325);
+  uint32_t mask = used_texture_mask, index;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(index);
+    const uint32_t* dwords = reinterpret_cast<const uint32_t*>(&fetch);
+    textures = (textures ^ index) * UINT64_C(0x100000001B3);
+    for (uint32_t d = 0; d < 6; ++d) {
+      textures = (textures ^ dwords[d]) * UINT64_C(0x100000001B3);
+    }
+  }
+  state.textures = textures;
+  for (const NativeDrawState& seen : item.states) {
+    if (seen == state) {
+      return;
+    }
+  }
+  if (item.states.size() < kMaxStates) {
+    item.states.push_back(state);
+  } else {
+    item.overflow = true;
+  }
+}
+
+void VulkanCommandProcessor::LogNativeDrawCensus() {
+  if (!native_materials_.empty()) {
+    std::vector<std::pair<uint64_t, std::pair<uint64_t, uint64_t>>> ranked;
+    for (const auto& material_pair : native_materials_) {
+      ranked.emplace_back(material_pair.second.draws, material_pair.first);
+    }
+    std::sort(ranked.begin(), ranked.end(), std::greater<>());
+    uint64_t cumulative = 0;
+    std::string line;
+    for (size_t i = 0; i < std::min<size_t>(ranked.size(), 20); ++i) {
+      const NativeMaterialCount& m = native_materials_[ranked[i].second];
+      cumulative += m.draws;
+      line += fmt::format(" [{} vs {:016X} ({} dw) ps {:016X} ({} dw): {:.1f}% of draws, {:.0f}% "
+                          "meshes, top {} = {:.1f}%]",
+                          i + 1, ranked[i].second.first, m.vs_dwords, ranked[i].second.second,
+                          m.ps_dwords, 100.0 * m.draws / native_census_draws_,
+                          m.draws ? 100.0 * m.mesh_draws / m.draws : 0.0, i + 1,
+                          100.0 * cumulative / native_census_draws_);
+    }
+    REXGPU_INFO("  native materials ({} shader pairs) by draws:{}", native_materials_.size(), line);
+  }
+  if (native_draw_items_.empty()) {
+    return;
+  }
+  // Items by how many distinct states they were drawn with, and how many have one vertex
+  // and pixel shader pair, one pipeline and one texture set.
+  uint64_t by_states[5] = {};  // 1, 2, 3-4, 5-16, more
+  uint64_t one_shaders = 0, one_pipeline = 0, one_textures = 0, draws_one_state = 0, draws = 0;
+  uint64_t stable_per_pass = 0, draws_stable_per_pass = 0;
+  for (const auto& item_pair : native_draw_items_) {
+    const NativeDrawItem& item = item_pair.second;
+    size_t n = item.states.size();
+    by_states[item.overflow ? 4 : n == 1 ? 0 : n == 2 ? 1 : n <= 4 ? 2 : 3]++;
+    bool shaders = true, pipelines = true, textures = true;
+    for (const NativeDrawState& st : item.states) {
+      shaders &= st.vertex_shader == item.states[0].vertex_shader &&
+                 st.pixel_shader == item.states[0].pixel_shader;
+      pipelines &= st.pipeline == item.states[0].pipeline;
+      textures &= st.textures == item.states[0].textures;
+    }
+    // Stable per pass: each shader pair always with the same pipeline and textures.
+    bool per_pass = !item.overflow;
+    for (const NativeDrawState& a : item.states) {
+      for (const NativeDrawState& b : item.states) {
+        if (a.vertex_shader == b.vertex_shader && a.pixel_shader == b.pixel_shader &&
+            (a.pipeline != b.pipeline || a.textures != b.textures)) {
+          per_pass = false;
+        }
+      }
+    }
+    stable_per_pass += per_pass;
+    if (per_pass) {
+      draws_stable_per_pass += item.draws;
+    }
+    one_shaders += shaders && !item.overflow;
+    one_pipeline += pipelines && !item.overflow;
+    one_textures += textures && !item.overflow;
+    draws += item.draws;
+    if (n == 1) {
+      draws_one_state += item.draws;
+    }
+  }
+  const double items = double(native_draw_items_.size());
+  REXGPU_INFO(
+      "  native draw census: {} mesh draw items, {:.1f}% of {} draws are engine meshes; items "
+      "with 1 state {:.1f}%, 2 {:.1f}%, 3-4 {:.1f}%, 5-16 {:.1f}%, more {:.1f}%; one shader "
+      "pair {:.1f}%, one pipeline {:.1f}%, one texture set {:.1f}%; draws of 1-state items "
+      "{:.1f}%; stable per shader pair: {:.1f}% of items, {:.1f}% of draws",
+      native_draw_items_.size(),
+      native_census_draws_ ? 100.0 * native_census_mesh_draws_ / native_census_draws_ : 0.0,
+      native_census_draws_, 100.0 * by_states[0] / items, 100.0 * by_states[1] / items,
+      100.0 * by_states[2] / items, 100.0 * by_states[3] / items, 100.0 * by_states[4] / items,
+      100.0 * one_shaders / items, 100.0 * one_pipeline / items, 100.0 * one_textures / items,
+      draws ? 100.0 * draws_one_state / draws : 0.0, 100.0 * stable_per_pass / items,
+      draws ? 100.0 * draws_stable_per_pass / draws : 0.0);
+}
+
+VulkanCommandProcessor::NativeRangeHit* VulkanCommandProcessor::FindNativeRange(
+    uint32_t start, uint32_t length) {
+  const uint32_t removal_version = native_ranges::RemovalVersion();
+  if (removal_version != native_range_hits_version_) {
+    native_range_hits_.clear();
+    native_range_hits_version_ = removal_version;
+  }
+  auto hit = native_range_hits_.find(start);
+  if (hit != native_range_hits_.end() && hit->second.length == length) {
+    return &hit->second;
+  }
+  const uint32_t change_version = native_ranges::ChangeVersion();
+  if (change_version != native_range_misses_version_) {
+    native_range_misses_.clear();
+    native_range_misses_version_ = change_version;
+  }
+  auto miss = native_range_misses_.find(start);
+  if (miss != native_range_misses_.end() && miss->second == length) {
+    return nullptr;
+  }
+  const uint32_t generation = native_ranges::Lookup(start, length);
+  if (!generation) {
+    native_range_misses_[start] = length;
+    return nullptr;
+  }
+  NativeRangeHit& entry = native_range_hits_[start];
+  entry = {length, generation, native_ranges_requested_.count(generation) != 0};
+  return &entry;
+}
+
+void VulkanCommandProcessor::BindGuestGraphicsPipeline(
+    VkPipeline pipeline, const VulkanPipelineCache::PipelineLayoutProvider* provider) {
+  if (current_guest_graphics_pipeline_ != pipeline) {
+    deferred_command_buffer_.CmdVkBindPipeline(VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+    current_guest_graphics_pipeline_ = pipeline;
+    current_external_graphics_pipeline_ = VK_NULL_HANDLE;
+  }
+
+  // Update the graphics pipeline, and if the new graphics pipeline has a
+  // different layout, invalidate incompatible descriptor sets before updating
+  // current_guest_graphics_pipeline_layout_.
+  auto pipeline_layout = static_cast<const PipelineLayout*>(provider);
+  if (current_guest_graphics_pipeline_layout_ != pipeline_layout) {
+    if (current_guest_graphics_pipeline_layout_) {
+      // Keep descriptor set layouts for which the new pipeline layout is
+      // compatible with the previous one (pipeline layouts are compatible for
+      // set N if set layouts 0 through N are compatible).
+      uint32_t descriptor_sets_kept = uint32_t(SpirvShaderTranslator::kDescriptorSetCount);
+      if (current_guest_graphics_pipeline_layout_->descriptor_set_layout_textures_vertex_ref() !=
+          pipeline_layout->descriptor_set_layout_textures_vertex_ref()) {
+        descriptor_sets_kept = std::min(
+            descriptor_sets_kept, uint32_t(SpirvShaderTranslator::kDescriptorSetTexturesVertex));
+      }
+      if (current_guest_graphics_pipeline_layout_->descriptor_set_layout_textures_pixel_ref() !=
+          pipeline_layout->descriptor_set_layout_textures_pixel_ref()) {
+        descriptor_sets_kept = std::min(
+            descriptor_sets_kept, uint32_t(SpirvShaderTranslator::kDescriptorSetTexturesPixel));
+      }
+    } else {
+      // No or unknown pipeline layout previously bound - all bindings are in an
+      // indeterminate state.
+      current_graphics_descriptor_sets_bound_up_to_date_ = 0;
+    }
+    current_guest_graphics_pipeline_layout_ = pipeline_layout;
+  }
+}
+
+int VulkanCommandProcessor::IssueNativeMeshDraw(xenos::PrimitiveType prim_type,
+                                                uint32_t index_count,
+                                                IndexBufferInfo* index_buffer_info) {
+  native_mesh_verify_passed_ = false;
+  auto it = native_mesh_entries_.find((uint64_t(native_marker_record_) << 32) |
+                                      native_marker_pass_);
+  if (it == native_mesh_entries_.end()) {
+    ++native_mesh_stats_[3];
+    return 0;
+  }
+  NativeMeshEntry& mesh = it->second;
+  const RegisterFile& regs = *register_file_;
+  if (mesh.prim_type != prim_type || mesh.index_count != index_count || !index_buffer_info ||
+      index_buffer_info->guest_base != mesh.index_guest_base ||
+      index_buffer_info->format != mesh.index_format ||
+      index_buffer_info->endianness != mesh.index_endianness) {
+    ++native_mesh_stats_[4];
+    return 0;
+  }
+  if (active_vertex_shader() != mesh.active_vertex_shader ||
+      active_pixel_shader() != mesh.active_pixel_shader) {
+    ++native_mesh_stats_[5];
+    return 0;
+  }
+  if (mesh.removal_version != native_ranges::RemovalVersion()) {
+    // Some range was replaced or forgotten: keep the entry if its own ones are the same.
+    bool ranges_same = mesh.index_generation != 0;
+    for (uint32_t i = 0; ranges_same && i < mesh.vfetch_count; ++i) {
+      const NativeRangeHit* hit = FindNativeRange(mesh.vfetch[i][1] << 2, mesh.vfetch[i][2] << 2);
+      ranges_same = hit && hit->requested && hit->generation == mesh.vfetch_generation[i];
+    }
+    if (ranges_same) {
+      const NativeRangeHit* hit = FindNativeRange(mesh.index_guest_base, mesh.index_length);
+      ranges_same = hit && hit->generation == mesh.index_generation;
+    }
+    if (!ranges_same) {
+      ++native_mesh_stats_[6];
+      native_mesh_entries_.erase(it);
+      return 0;
+    }
+    mesh.removal_version = native_ranges::RemovalVersion();
+  }
+  auto replay_it = native_replay_entries_.find(mesh.replay_key);
+  if (replay_it == native_replay_entries_.end() || !replay_it->second.fast_valid ||
+      replay_it->second.state_hash != state_hash_) {
+    ++native_mesh_stats_[7];
+    return 0;
+  }
+  for (uint32_t i = 0; i < mesh.vfetch_count; ++i) {
+    xenos::xe_gpu_vertex_fetch_t vfetch = regs.GetVertexFetch(mesh.vfetch[i][0]);
+    if (vfetch.type != xenos::FetchConstantType::kVertex || vfetch.address != mesh.vfetch[i][1] ||
+        vfetch.size != mesh.vfetch[i][2] || native_ranges::IsDirty(mesh.vfetch_generation[i])) {
+      // A written range: the usual draw requests it again.
+      ++native_mesh_stats_[8];
+      return 0;
+    }
+  }
+  DrawSectionMark(17);
+  if (!BeginSubmission(true)) {
+    return -1;
+  }
+  DrawSectionMark(18);
+  // The render targets must be the ones the last update made (render target update memo).
+  RenderTargetUpdateInputs rt_inputs = mesh.rt_inputs;
+  static constexpr uint32_t kRenderTargetUpdateRegisters[14] = {
+      XE_GPU_REG_RB_SURFACE_INFO,         XE_GPU_REG_RB_COLOR_INFO,
+      XE_GPU_REG_RB_DEPTH_INFO,           XE_GPU_REG_RB_COLOR1_INFO,
+      XE_GPU_REG_RB_COLOR2_INFO,          XE_GPU_REG_RB_COLOR3_INFO,
+      XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL, XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR,
+      XE_GPU_REG_PA_SC_WINDOW_OFFSET,     XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL,
+      XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR, XE_GPU_REG_RB_STENCILREFMASK_BF,
+      XE_GPU_REG_RB_STENCILREFMASK,       XE_GPU_REG_PA_CL_CLIP_CNTL};
+  for (uint32_t r = 0; r < 14; ++r) {
+    rt_inputs.registers[r] = regs.values[kRenderTargetUpdateRegisters[r]];
+  }
+  if (!REXCVAR_GET(gpu_render_target_update_memo) || !rt_update_memo_valid_ ||
+      !(rt_inputs == rt_update_inputs_) ||
+      replay_it->second.render_pass_key != render_target_cache_->last_update_render_pass_key()) {
+    ++native_mesh_stats_[9];
+    return 0;
+  }
+  DrawSectionMark(27);
+  native_replay_key_ = mesh.replay_key;
+  NativeReplayEntry* replay = TryNativeReplay(mesh.used_texture_mask);
+  if (!replay) {
+    ++native_mesh_stats_[10];
+    return 0;
+  }
+  if (REXCVAR_GET(native_mesh_draw_verify)) {
+    // Draw the usual way; the learning step compares what it makes with the entry.
+    native_mesh_verify_passed_ = true;
+    return 0;
+  }
+
+  // From here on, the draw is made natively.
+  DrawSectionMark(19);
+  ++native_mesh_stats_[0];
+  memexport_ranges_.clear();
+  texture_cache_->UseCapturedTextures(replay->textures);
+  BindGuestGraphicsPipeline(replay->pipeline, replay->pipeline_layout_provider);
+  UpdateDynamicState(replay->viewport_info, mesh.primitive_polygonal,
+                     mesh.normalized_depth_control);
+  DrawSectionMark(20);
+  if (render_target_cache_->GetPath() == RenderTargetCache::Path::kHostRenderTargets) {
+    UpdateFrameGenerationCamera(*mesh.vertex_shader, mesh.normalized_depth_control,
+                                replay->viewport_info);
+  }
+  DrawSectionMark(21);
+  if (std::memcmp(&system_constants_, &replay->system_constants, sizeof(system_constants_))) {
+    std::memcpy(&system_constants_, &replay->system_constants, sizeof(system_constants_));
+    current_constant_buffers_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferSystem);
+  }
+  native_replay_ = replay;
+  const bool bindings_updated = UpdateBindings(mesh.vertex_shader, mesh.pixel_shader);
+  native_replay_ = nullptr;
+  DrawSectionMark(22);
+  if (!bindings_updated) {
+    return -1;
+  }
+  for (uint32_t i = 0; i < mesh.vfetch_count; ++i) {
+    const uint32_t vfetch_index = mesh.vfetch[i][0];
+    const uint64_t vfetch_bit = uint64_t(1) << (vfetch_index & 63);
+    if (!(vertex_buffers_in_sync_[vfetch_index >> 6] & vfetch_bit)) {
+      VertexBufferState& state = vertex_buffer_states_[vfetch_index];
+      state.address = mesh.vfetch[i][1];
+      state.size = mesh.vfetch[i][2];
+      vertex_buffers_in_sync_[vfetch_index >> 6] |= vfetch_bit;
+    }
+  }
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriersAndEnterRenderTargetCacheRenderPass(
+      render_target_cache_->last_update_render_pass(),
+      render_target_cache_->last_update_framebuffer());
+  const std::pair<VkBuffer, VkDeviceSize> index_buffer = mesh.index_buffer;
+  const VkIndexType index_type =
+      mesh.primitive_result.host_index_format == xenos::IndexFormat::kInt16 ? VK_INDEX_TYPE_UINT16
+                                                                            : VK_INDEX_TYPE_UINT32;
+  const uint32_t index_size_log2 = index_type == VK_INDEX_TYPE_UINT16 ? 1 : 2;
+  uint32_t first_index = 0;
+  if (REXCVAR_GET(vulkan_merge_draw_binds) &&
+      !(index_buffer.second & ((VkDeviceSize(1) << index_size_log2) - 1)) &&
+      (index_buffer.second >> index_size_log2) <= UINT32_MAX) {
+    first_index = uint32_t(index_buffer.second >> index_size_log2);
+    if (current_index_buffer_ != index_buffer.first || current_index_type_ != index_type) {
+      deferred_command_buffer_.CmdVkBindIndexBuffer(index_buffer.first, 0, index_type);
+      current_index_buffer_ = index_buffer.first;
+      current_index_type_ = index_type;
+    }
+  } else {
+    deferred_command_buffer_.CmdVkBindIndexBuffer(index_buffer.first, index_buffer.second,
+                                                  index_type);
+    current_index_buffer_ = VK_NULL_HANDLE;
+  }
+  GpuTimingShaders(mesh.vertex_shader, mesh.pixel_shader);
+  PROFILE_DRAW_CALL();
+  PROFILE_VERTICES(mesh.primitive_result.host_draw_vertex_count);
+  deferred_command_buffer_.CmdVkDrawIndexed(mesh.primitive_result.host_draw_vertex_count, 1,
+                                            first_index, 0, 0);
+  return 1;
+}
+
+bool VulkanCommandProcessor::TryIssueClearAsRenderTargetClear(xenos::PrimitiveType prim_type,
+                                                              uint32_t index_count) {
+  // Native render targets, step 2 (gpu_clear_as_render_target_clear): Direct3D's clear (its
+  // vertex shader, a screen-space rectangle with the color in the vertices) done as a render
+  // target cache clear, like a resolve clear: the cache then gives the cleared rectangle to the
+  // render targets being cleared without copying the EDRAM's previous contents into it.
+  // Anything this does not cover is drawn the usual way.
+  auto reason = [&](uint32_t r) {
+    ++clear_as_rt_clear_stats_[r];
+    if (gpu_timing_sequence_active_ && gpu_timing_frame_active_) {
+      const Shader* log_ps = active_pixel_shader();
+      GpuTimingSequence(fmt::format(
+          "  clear not as render target clear: reason {} depthcontrol {:08X} colormask {:08X} "
+          "blend {:08X} colorcontrol {:08X} ps {:016X} surface {:08X}",
+          r, register_file_->values[XE_GPU_REG_RB_DEPTHCONTROL],
+          register_file_->values[XE_GPU_REG_RB_COLOR_MASK],
+          register_file_->values[XE_GPU_REG_RB_BLENDCONTROL0],
+          register_file_->values[XE_GPU_REG_RB_COLORCONTROL],
+          log_ps ? log_ps->ucode_data_hash() : 0,
+          register_file_->values[XE_GPU_REG_RB_SURFACE_INFO]));
+    }
+    return false;
+  };
+  const RegisterFile& regs = *register_file_;
+  const Shader* vs = active_vertex_shader();
+  if (!vs || vs->ucode_data_hash() != UINT64_C(0x0A6D1DD7767FDF27) ||
+      prim_type != xenos::PrimitiveType::kRectangleList || index_count != 3 ||
+      vs->vertex_bindings().empty()) {
+    return false;
+  }
+  if (render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) {
+    return reason(1);
+  }
+  // With draw resolution scaling the rectangle stays in guest pixels; the cache scales it.
+  const uint32_t clear_scale_x = texture_cache_->draw_resolution_scale_x();
+  const uint32_t clear_scale_y = texture_cache_->draw_resolution_scale_y();
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  auto mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  if ((surface_info.msaa_samples != xenos::MsaaSamples::k1X &&
+       surface_info.msaa_samples != xenos::MsaaSamples::k4X) ||
+      (vte.value & 0xF) || !vte.vtx_xy_fmt ||
+      (mode_cntl.vtx_window_offset_enable &&
+       (window_offset.window_x_offset || window_offset.window_y_offset)) ||
+      regs.Get<reg::PA_SC_VIZ_QUERY>().viz_query_ena) {
+    return reason(2);
+  }
+  // The rectangle and the values, from the vertices (x y z, then the color).
+  const Shader::VertexBinding& binding = vs->vertex_bindings()[0];
+  xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(binding.fetch_constant);
+  if (vf.type != xenos::FetchConstantType::kVertex || binding.stride_words != 7 ||
+      vf.size < 21) {
+    return reason(3);
+  }
+  const uint32_t* data = memory_->TranslatePhysical<const uint32_t*>(vf.address << 2);
+  if (!data) {
+    return reason(3);
+  }
+  float v[21];
+  for (uint32_t i = 0; i < 21; ++i) {
+    uint32_t word = xenos::GpuSwap(data[i], vf.endian);
+    std::memcpy(&v[i], &word, sizeof(word));
+  }
+  for (uint32_t i = 1; i < 3; ++i) {
+    for (uint32_t c = 2; c < 7; ++c) {
+      if (v[i * 7 + c] != v[c]) {
+        return reason(4);  // Not one depth and color.
+      }
+    }
+  }
+  // Pixel edges: x + 0.5 (Direct3D's half-pixel offset), in 1x pixels.
+  const float half =
+      REXCVAR_GET(half_pixel_offset) &&
+              regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero
+          ? 0.5f
+          : 0.0f;
+  const float scale = surface_info.msaa_samples == xenos::MsaaSamples::k4X ? 2.0f : 1.0f;
+  float edges[4] = {std::min({v[0], v[7], v[14]}), std::min({v[1], v[8], v[15]}),
+                    std::max({v[0], v[7], v[14]}), std::max({v[1], v[8], v[15]})};
+  int32_t rect[4];
+  for (uint32_t i = 0; i < 4; ++i) {
+    const float edge = (edges[i] + half) * scale;
+    rect[i] = int32_t(edge);
+    if (float(rect[i]) != edge || (rect[i] & 7)) {
+      return reason(5);  // Not whole 8-pixel blocks.
+    }
+  }
+  const uint32_t pitch_1x = surface_info.surface_pitch * uint32_t(scale);
+  if (rect[0] < 0 || rect[1] < 0 || rect[2] <= rect[0] || rect[3] <= rect[1] ||
+      uint32_t(rect[2]) > pitch_1x || rect[3] - rect[1] > int32_t(xenos::kMaxResolveSize)) {
+    return reason(5);
+  }
+  // Inside the scissors (which are wide open in the clears seen).
+  auto window_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto window_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  if (int32_t(window_tl.tl_x * scale) > rect[0] || int32_t(window_tl.tl_y * scale) > rect[1] ||
+      int32_t(window_br.br_x * scale) < rect[2] || int32_t(window_br.br_y * scale) < rect[3]) {
+    return reason(6);
+  }
+  // What is written: depth (and stencil) and/or color 0, nothing else, no blending.
+  auto depthcontrol = regs.Get<reg::RB_DEPTHCONTROL>();
+  // Direct3D's clear pixel shader writes only color target 0; the others' masks don't matter.
+  const uint32_t color_mask = regs.values[XE_GPU_REG_RB_COLOR_MASK] & 0xF;
+  const bool clear_depth = depthcontrol.z_enable && depthcontrol.z_write_enable;
+  const bool clear_color = (color_mask & 0xF) != 0;
+  if ((color_mask & ~uint32_t(0xF)) || (clear_color && (color_mask & 0xF) != 0xF) ||
+      (!clear_depth && !clear_color) ||
+      (depthcontrol.z_enable && depthcontrol.zfunc != xenos::CompareFunction::kAlways) ||
+      (!clear_depth && depthcontrol.stencil_enable)) {
+    return reason(7);
+  }
+  if (clear_color && regs.values[XE_GPU_REG_RB_BLENDCONTROL0] != 0x00010001) {
+    return reason(7);
+  }
+  // Only Direct3D's clear pixel shader (oC0 = the vertex color) or none, nothing discarded.
+  // The pixel shader as the usual draw would use it: none for a depth-only clear when it is
+  // not needed (then no alpha test either), otherwise Direct3D's clear shader, no alpha test.
+  auto* ps = static_cast<VulkanShader*>(active_pixel_shader());
+  if (ps) {
+    pipeline_cache_->AnalyzeShaderUcode(*ps);
+    if (!clear_color && !draw_util::IsPixelShaderNeededWithRasterization(*ps, regs)) {
+      ps = nullptr;
+    }
+  }
+  if (clear_color && !ps) {
+    return reason(7);
+  }
+  if (ps) {
+    auto colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+    if (ps->ucode_data_hash() != UINT64_C(0x2E372EA28CC404B7) || colorcontrol.alpha_test_enable ||
+        colorcontrol.alpha_to_mask_enable) {
+      return reason(7);
+    }
+  }
+  if (!(REXCVAR_GET(gpu_clear_as_render_target_clear_kinds) & (clear_color ? 2 : 1))) {
+    return reason(7);
+  }
+  if (clear_color && (v[3] != 0.0f || v[4] != 0.0f || v[5] != 0.0f || v[6] != 0.0f)) {
+    return reason(8);  // Only zero (the same bits in every format) for now.
+  }
+  auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  uint32_t depth_clear = 0;
+  if (clear_depth) {
+    // A resolve clear writes depth and stencil together: the stencil must be written as well.
+    auto stencil = regs.Get<reg::RB_STENCILREFMASK>();
+    uint32_t stencil_value;
+    if (!depthcontrol.stencil_enable ||
+        depthcontrol.stencilfunc != xenos::CompareFunction::kAlways ||
+        stencil.stencilwritemask != 0xFF) {
+      return reason(9);
+    }
+    if (depthcontrol.stencilzpass == xenos::StencilOp::kZero) {
+      stencil_value = 0;
+    } else if (depthcontrol.stencilzpass == xenos::StencilOp::kReplace) {
+      stencil_value = stencil.stencilref;
+    } else {
+      return reason(9);
+    }
+    const float z = std::clamp(v[2], 0.0f, 1.0f);
+    const uint32_t depth24 =
+        depth_info.depth_format == xenos::DepthRenderTargetFormat::kD24FS8
+            ? xenos::Float32To20e4(z, true)
+            : uint32_t(std::lround(double(z) * 0xFFFFFF));
+    depth_clear = (depth24 << 8) | stencil_value;
+  }
+
+  // The resolve-clear description of this rectangle on the 1x surface.
+  draw_util::ResolveInfo info = {};
+  info.rb_copy_control.copy_src_select = 0;
+  info.rb_copy_control.depth_clear_enable = clear_depth;
+  info.rb_copy_control.color_clear_enable = clear_color;
+  const uint32_t pitch_tiles =
+      xenos::GetSurfacePitchTiles(pitch_1x, xenos::MsaaSamples::k1X, false);
+  // Fills the coordinates of a rectangle in (depth and color bases set after).
+  auto set_rectangle = [clear_scale_x, clear_scale_y](draw_util::ResolveInfo& info, const int32_t* rect, uint32_t pitch_tiles,
+                          uint32_t depth_base, uint32_t color_base) {
+    const uint32_t base_offset_tiles = (uint32_t(rect[1]) / xenos::kEdramTileHeightSamples) *
+                                           pitch_tiles +
+                                       uint32_t(rect[0]) / xenos::kEdramTileWidthSamples;
+    info.coordinate_info.edram_offset_x_div_8 =
+        (uint32_t(rect[0]) % xenos::kEdramTileWidthSamples) >> 3;
