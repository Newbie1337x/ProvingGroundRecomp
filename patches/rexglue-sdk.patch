+    GpuTimingSequence(fmt::format("clear as render target clear {} {} {} {} depth {} {:08X} "
+                                  "color {} surface {:08X} color0 {:08X} depthinfo {:08X} "
+                                  "colorvalue {:g} {:g} {:g} {:g}",
+                                  rect[0], rect[1], rect[2], rect[3], clear_depth, depth_clear,
+                                  clear_color, regs.values[XE_GPU_REG_RB_SURFACE_INFO],
+                                  regs.values[XE_GPU_REG_RB_COLOR_INFO],
+                                  regs.values[XE_GPU_REG_RB_DEPTH_INFO], v[3], v[4], v[5], v[6]));
+  }
+  const uint32_t depth_base = clear_depth ? uint32_t(depth_info.depth_base) : 0;
+  const uint32_t color_base =
+      clear_color ? uint32_t(regs.Get<reg::RB_COLOR_INFO>().color_base) : 0;
+  ++clear_as_rt_clear_stats_[0];
