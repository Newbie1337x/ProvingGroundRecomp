@@ -661,6 +736,43 @@ class RenderTargetCache {
   // changes to this throughout a frame are pretty rare.
   std::map<uint32_t, OwnershipRange> ownership_ranges_;
 
+ protected:
+  // The render target owning every tile of the rows (row_length tiles every pitch tiles from
+  // base), or nullptr if a tile has no owner or the owners differ.
+  RenderTarget* GetSoleOwnerRenderTarget(uint32_t base, uint32_t row_length, uint32_t rows,
+                                         uint32_t pitch) const {
+    if (!row_length || !rows || base + (rows - 1) * pitch + row_length > xenos::kEdramTileCount) {
+      return nullptr;
+    }
+    RenderTargetKey owner;
+    for (uint32_t row = 0; row < rows; ++row) {
+      uint32_t position = base + row * pitch;
+      const uint32_t row_end = position + row_length;
+      auto it = ownership_ranges_.upper_bound(position);
+      if (it == ownership_ranges_.begin()) {
+        return nullptr;
+      }
+      --it;
+      while (position < row_end) {
+        if (it == ownership_ranges_.end() || it->first > position ||
+            it->second.end_tiles <= position || it->second.render_target.IsEmpty()) {
+          return nullptr;
+        }
+        if (owner.IsEmpty()) {
+          owner = it->second.render_target;
+        } else if (it->second.render_target != owner) {
+          return nullptr;
+        }
+        position = it->second.end_tiles;
+        ++it;
+      }
+    }
+    auto rt_it = render_targets_.find(owner);
+    return rt_it != render_targets_.end() ? rt_it->second : nullptr;
+  }
+
+ private:
