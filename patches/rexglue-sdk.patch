+  // native_hoist_texture_loads: inside a render pass, nothing has written shared memory since it
+  // began (an upload or a GPU write would have ended it with its barrier), so the load can be
+  // done before it, if no draw of it has sampled this texture.
+  if (REXCVAR_GET(native_hoist_texture_loads) && !texture.key().scaled_resolve &&
+      loaded_texture.sampled_render_pass_serial != command_processor_.render_pass_serial() &&
+      static_cast<VulkanSharedMemory&>(shared_memory()).IsReadWithoutBarrier() &&
+      command_processor_.BeginHoistBeforeRenderPass()) {
+    const bool hoisted_result =
+        LoadTextureDataFromResidentMemoryImplInner(texture, load_base, load_mips);
+    if (hoisted_result) {
+      // Ready for sampling before the render pass too, so the draw needs no barrier.
+      VulkanTexture::Usage old_usage =
+          loaded_texture.SetUsage(VulkanTexture::Usage::kGuestShaderSampled);
+      if (old_usage != VulkanTexture::Usage::kGuestShaderSampled) {
+        VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+        VkAccessFlags src_access_mask, dst_access_mask;
+        VkImageLayout old_layout, new_layout;
+        GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+        GetTextureUsageMasks(VulkanTexture::Usage::kGuestShaderSampled, dst_stage_mask,
+                             dst_access_mask, new_layout);
+        command_processor_.PushImageMemoryBarrier(
+            loaded_texture.image(), ui::vulkan::util::InitializeSubresourceRange(),
+            src_stage_mask, dst_stage_mask, src_access_mask, dst_access_mask, old_layout,
+            new_layout);
+      }
+    }
+    command_processor_.EndHoistBeforeRenderPass();
+    if (command_processor_.IsGpuTimingSequenceActive()) {
+      const TextureKey& hoisted_key = texture.key();
+      command_processor_.GpuTimingSequence(
+          fmt::format("texture load {:08X} {}x{} format {} hoisted before the render pass",
+                      hoisted_key.base_page << 12, hoisted_key.width_minus_1 + 1,
+                      hoisted_key.height_minus_1 + 1, uint32_t(hoisted_key.format)));
+    }
+    return hoisted_result;
+  }
+  // Timed separately (vulkan_gpu_timing), with each load in the frame sequence log.
+  if (!command_processor_.IsGpuTimingActive()) {
+    return LoadTextureDataFromResidentMemoryImplInner(texture, load_base, load_mips);
+  }
+  const TextureKey key = texture.key();
+  if (command_processor_.IsGpuTimingSequenceActive()) {
+    command_processor_.GpuTimingSequence(fmt::format(
+        "texture load {:08X} {}x{} format {} tiled {} pitch {} scaled {} base {} mips {}",
+        key.base_page << 12, key.width_minus_1 + 1, key.height_minus_1 + 1, uint32_t(key.format),
+        uint32_t(key.tiled), uint32_t(key.pitch), uint32_t(key.scaled_resolve), load_base,
+        load_mips));
+  }
+  // Render-to-texture targets (8888, no mips: what the game resolves) apart from the others.
+  const bool resolve_like = key.format == xenos::TextureFormat::k_8_8_8_8 && !key.mip_max_level;
+  command_processor_.GpuTimingMark(VulkanCommandProcessor::GpuTimingCategory::kOther);
+  const bool result = LoadTextureDataFromResidentMemoryImplInner(texture, load_base, load_mips);
+  command_processor_.GpuTimingMark(command_processor_.GpuTimingNamedCategory(
+      resolve_like ? "texture loads (resolved targets)" : "texture loads (other)"));
+  return result;
+}
+
+void VulkanTextureCache::LearnDirectResolveTexture(VulkanTexture& texture) {
+  const TextureKey& key = texture.key();
+  if (key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
+      !key.tiled || key.mip_max_level || key.signed_separate || key.own_scale_sixteenths ||
+      bool(key.scaled_resolve) != IsDrawResolutionScaled()) {
+    return;
+  }
+  VkFormat expected_host_format;
+  if (key.format == xenos::TextureFormat::k_8_8_8_8) {
+    expected_host_format = VK_FORMAT_R8G8B8A8_UNORM;
+  } else if (key.format == xenos::TextureFormat::k_24_8_FLOAT ||
+             key.format == xenos::TextureFormat::k_24_8) {
+    // k_24_8: the unorm24 of the depth word (a float24 depth resolve sampled that way).
+    expected_host_format = VK_FORMAT_R32_SFLOAT;
+  } else {
+    return;
+  }
+  const uint32_t base = key.base_page << 12;
+  if (std::find(direct_resolve_blocked_.begin(), direct_resolve_blocked_.end(), base) !=
+          direct_resolve_blocked_.end() ||
+      GetHostFormatPair(key).format_unsigned.format != expected_host_format) {
+    return;
+  }
+  direct_resolve_textures_[base] = &texture;
+}
+
+bool VulkanTextureCache::CanResolveDirectlyToTexture(uint32_t dest_base, uint32_t width,
+                                                     uint32_t height, uint32_t pitch_div_32,
+                                                     xenos::Endian endian,
+                                                     xenos::TextureFormat format,
+                                                     bool own_scale) {
+  auto it = direct_resolve_textures_.find(dest_base);
+  if (it == direct_resolve_textures_.end()) {
+    return false;
+  }
+  const VulkanTexture& texture = *it->second;
+  const TextureKey& key = texture.key();
+  const uint32_t texture_width = key.width_minus_1 + 1;
+  const uint32_t texture_height = key.height_minus_1 + 1;
+  // The resolve must cover the whole texture (it is 8-aligned, the texture may be smaller by
+  // less than 8), and the texture must be current (else a load would overwrite the copy).
+  return texture_width <= width && width - texture_width < 8 && texture_height <= height &&
+         height - texture_height < 8 && key.pitch == pitch_div_32 && key.endianness == endian &&
+         (key.format == format || (format == xenos::TextureFormat::k_24_8_FLOAT &&
+                                   key.format == xenos::TextureFormat::k_24_8)) &&
+         (own_scale || !texture.outdated_mask()) &&
+         std::find(direct_resolve_blocked_.begin(), direct_resolve_blocked_.end(), dest_base) ==
+             direct_resolve_blocked_.end();
+}
+
+void VulkanTextureCache::ResolveDirectlyToTexture(uint32_t dest_base, VkImage source,
+                                                  int32_t source_x, int32_t source_y,
+                                                  uint32_t fill_x, uint32_t fill_y,
+                                                  uint32_t range_start, uint32_t range_length) {
+  VulkanTexture& texture = *direct_resolve_textures_.find(dest_base)->second;
+  const TextureKey& key = texture.key();
+  texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  command_processor_.SubmitBarriers(true);
+  const uint32_t width = (key.width_minus_1 + 1) * (key.scaled_resolve ? draw_resolution_scale_x() : 1);
+  const uint32_t height =
+      (key.height_minus_1 + 1) * (key.scaled_resolve ? draw_resolution_scale_y() : 1);
+  // The covered part, then the half-pixel offset gap (if any) from the first covered column /
+  // row, with no region written twice.
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  auto copy = [&](uint32_t dest_x, uint32_t dest_y, uint32_t copy_width, uint32_t copy_height) {
+    VkImageCopy region = {};
+    region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.srcSubresource.layerCount = 1;
+    region.srcOffset.x = source_x + int32_t(dest_x < fill_x ? fill_x : dest_x);
+    region.srcOffset.y = source_y + int32_t(dest_y < fill_y ? fill_y : dest_y);
+    region.dstSubresource = region.srcSubresource;
+    region.dstOffset.x = int32_t(dest_x);
+    region.dstOffset.y = int32_t(dest_y);
+    region.extent.width = copy_width;
+    region.extent.height = copy_height;
+    region.extent.depth = 1;
+    command_buffer.CmdVkCopyImage(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+                                  VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region);
+  };
+  copy(fill_x, fill_y, width - fill_x, height - fill_y);
+  for (uint32_t x = 0; x < fill_x; ++x) {
+    copy(x, fill_y, 1, height - fill_y);
+  }
+  for (uint32_t y = 0; y < fill_y; ++y) {
+    copy(fill_x, y, width - fill_x, 1);
+    for (uint32_t x = 0; x < fill_x; ++x) {
+      copy(x, y, 1, 1);
+    }
+  }
+  bool range_known = false;
+  for (const auto& range : direct_resolve_ranges_) {
+    if (range.first == range_start && range.second == range_length) {
+      range_known = true;
+      break;
+    }
+  }
+  if (!range_known) {
+    direct_resolve_ranges_.emplace_back(range_start, range_length);
+  }
+  InvalidateRangeExcept(texture, range_start, range_length);
+  ++direct_resolve_stats_[0];
+}
+
+bool VulkanTextureCache::ResolveDirectlyToOwnScaleTexture(
+    uint32_t dest_base, VkImage source, int32_t source_x, int32_t source_y,
+    uint32_t source_width, uint32_t source_height, uint32_t scale_sixteenths,
+    uint32_t range_start, uint32_t range_length) {
+  VulkanTexture& unscaled_texture = *direct_resolve_textures_.find(dest_base)->second;
+  TextureKey key = unscaled_texture.key();
+  key.own_scale_sixteenths = scale_sixteenths;
+  VulkanTexture* texture_ptr = static_cast<VulkanTexture*>(FindOrCreateTexture(key));
+  if (!texture_ptr) {
+    return false;
+  }
+  VulkanTexture& texture = *texture_ptr;
+  // The unscaled one stays learned (it is not sampled while this one is current).
+  unscaled_texture.MarkAsUsed();
+  texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  command_processor_.SubmitBarriers(true);
+  const uint32_t width = std::max(key.GetWidth() * scale_sixteenths / 16, UINT32_C(1));
+  const uint32_t height = std::max(key.GetHeight() * scale_sixteenths / 16, UINT32_C(1));
+  VkImageCopy region = {};
+  region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.srcSubresource.layerCount = 1;
+  region.srcOffset.x = source_x;
+  region.srcOffset.y = source_y;
+  region.dstSubresource = region.srcSubresource;
+  region.extent.width = std::min(width, source_width - uint32_t(source_x));
+  region.extent.height = std::min(height, source_height - uint32_t(source_y));
+  region.extent.depth = 1;
+  command_processor_.deferred_command_buffer().CmdVkCopyImage(
+      source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region);
+  bool range_known = false;
+  for (const auto& range : direct_resolve_ranges_) {
+    if (range.first == range_start && range.second == range_length) {
+      range_known = true;
+      break;
+    }
+  }
+  if (!range_known) {
+    direct_resolve_ranges_.emplace_back(range_start, range_length);
+  }
+  // The unscaled texture and the others over the range become outdated, this one current.
+  InvalidateRangeExcept(texture, range_start, range_length);
+  SetOwnScaleBase(dest_base, scale_sixteenths);
+  ++direct_resolve_stats_[0];
+  ++own_scale_resolve_count_;
+  if (command_processor_.IsGpuTimingSequenceActive()) {
+    command_processor_.GpuTimingSequence(
+        fmt::format("own-scale resolve {:08X} {}x{} at {}/16", dest_base, key.GetWidth(),
+                    key.GetHeight(), scale_sixteenths));
+  }
+  return true;
+}
+
+bool VulkanTextureCache::ResolveThroughBufferToTexture(uint32_t dest_base, VkImage source,
+                                                       int32_t source_x, int32_t source_y,
+                                                       uint32_t fill_x, uint32_t fill_y,
+                                                       bool is_depth, bool round_to_nearest_even,
+                                                       uint32_t range_start,
+                                                       uint32_t range_length,
+                                                       uint32_t own_scale_sixteenths,
+                                                       uint32_t source_width,
+                                                       uint32_t source_height,
+                                                       uint32_t depth_source_kind) {
+  if (!EnsureDepthFloat24Pass()) {
+    return false;
+  }
+  VulkanTexture* texture_ptr = direct_resolve_textures_.find(dest_base)->second;
+  const TextureKey& key = texture_ptr->key();
+  uint32_t width = (key.width_minus_1 + 1) * (key.scaled_resolve ? draw_resolution_scale_x() : 1);
+  uint32_t height =
+      (key.height_minus_1 + 1) * (key.scaled_resolve ? draw_resolution_scale_y() : 1);
+  if (own_scale_sixteenths) {
+    // native_main_pass_scale_sixteenths: into the texture at the render target's own scale
+    // (source_x/y and source_width/height in its pixels), as ResolveDirectlyToOwnScaleTexture.
+    TextureKey own_scale_key = key;
+    own_scale_key.own_scale_sixteenths = own_scale_sixteenths;
+    VulkanTexture* own_scale_texture =
+        static_cast<VulkanTexture*>(FindOrCreateTexture(own_scale_key));
+    if (!own_scale_texture) {
+      return false;
+    }
+    texture_ptr->MarkAsUsed();
+    texture_ptr = own_scale_texture;
+    width = std::min(std::max(own_scale_key.GetWidth() * own_scale_sixteenths / 16, UINT32_C(1)),
+                     source_width - uint32_t(source_x));
+    height =
+        std::min(std::max(own_scale_key.GetHeight() * own_scale_sixteenths / 16, UINT32_C(1)),
+                 source_height - uint32_t(source_y));
+    fill_x = 0;
+    fill_y = 0;
+  }
+  VulkanTexture& texture = *texture_ptr;
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  VulkanCommandProcessor::ScratchBufferAcquisition scratch(
+      command_processor_.AcquireScratchGpuBuffer(VkDeviceSize(width) * height * sizeof(float),
+                                                 VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                                 VK_ACCESS_TRANSFER_WRITE_BIT));
+  if (scratch.buffer() == VK_NULL_HANDLE) {
+    return false;
+  }
+  command_processor_.SubmitBarriers(true);
+  VkBufferImageCopy region = {};
+  region.imageSubresource.aspectMask =
+      is_depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
+  region.imageSubresource.layerCount = 1;
+  region.imageOffset.x = source_x;
+  region.imageOffset.y = source_y;
+  region.imageExtent.width = width;
+  region.imageExtent.height = height;
+  region.imageExtent.depth = 1;
+  command_buffer.CmdVkCopyImageToBuffer(source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                        scratch.buffer(), region);
+  // To float24 and back, in place.
+  const uint32_t texel_count = width * height;
+  VkDescriptorSet descriptor_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (!descriptor_set) {
+    return false;
+  }
+  {
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+    VkDescriptorBufferInfo buffer_info;
+    buffer_info.buffer = scratch.buffer();
+    buffer_info.offset = 0;
+    buffer_info.range = VkDeviceSize(texel_count) * sizeof(uint32_t);
+    VkWriteDescriptorSet write = {};
+    write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write.dstSet = descriptor_set;
+    write.dstBinding = 0;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    write.pBufferInfo = &buffer_info;
+    vulkan_device->functions().vkUpdateDescriptorSets(vulkan_device->device(), 1, &write, 0,
+                                                      nullptr);
+  }
+  command_processor_.PushBufferMemoryBarrier(
+      scratch.buffer(), 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+  command_processor_.SubmitBarriers(true);
+  command_processor_.BindExternalComputePipeline(depth_float24_pass_pipeline_);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         depth_float24_pass_layout_, 0, 1, &descriptor_set, 0,
+                                         nullptr);
+  const uint32_t push_constants[3] = {
+      texel_count, uint32_t(round_to_nearest_even),
+      !is_depth ? 1u
+      : depth_source_kind == kDepthSourceUnorm24AsFloat32 ? 3u
+      : depth_source_kind == kDepthSourceUnorm24          ? 4u
+      : key.format == xenos::TextureFormat::k_24_8        ? 2u
+                                                          : 0u};
+  command_buffer.CmdVkPushConstants(depth_float24_pass_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(push_constants), push_constants);
+  command_buffer.CmdVkDispatch((texel_count + 63) / 64, 1, 1);
+  command_processor_.PushBufferMemoryBarrier(
+      scratch.buffer(), 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+  scratch.SetStageMask(VK_PIPELINE_STAGE_TRANSFER_BIT);
+  scratch.SetAccessMask(VK_ACCESS_TRANSFER_READ_BIT);
+  texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage_mask,
+                       dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout);
+  command_processor_.SubmitBarriers(true);
+  // The covered part, then the half-pixel offset gap (if any) from the first covered column /
+  // row of the buffer, with no region written twice.
+  VkBufferImageCopy regions[1 + 2 * 2 + 2 * 2];
+  uint32_t region_count = 0;
+  auto add_region = [&](uint32_t dest_x, uint32_t dest_y, uint32_t copy_width,
+                        uint32_t copy_height) {
+    VkBufferImageCopy& dest_region = regions[region_count++];
+    dest_region = {};
+    const uint32_t buffer_x = dest_x < fill_x ? fill_x : dest_x;
+    const uint32_t buffer_y = dest_y < fill_y ? fill_y : dest_y;
+    dest_region.bufferOffset = (VkDeviceSize(buffer_y) * width + buffer_x) * sizeof(uint32_t);
+    dest_region.bufferRowLength = width;
+    dest_region.bufferImageHeight = height;
+    dest_region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    dest_region.imageSubresource.layerCount = 1;
+    dest_region.imageOffset.x = int32_t(dest_x);
+    dest_region.imageOffset.y = int32_t(dest_y);
+    dest_region.imageExtent.width = copy_width;
+    dest_region.imageExtent.height = copy_height;
+    dest_region.imageExtent.depth = 1;
+  };
+  add_region(fill_x, fill_y, width - fill_x, height - fill_y);
+  for (uint32_t x = 0; x < fill_x; ++x) {
+    add_region(x, fill_y, 1, height - fill_y);
+  }
+  for (uint32_t y = 0; y < fill_y; ++y) {
+    add_region(fill_x, y, width - fill_x, 1);
+    for (uint32_t x = 0; x < fill_x; ++x) {
+      add_region(x, y, 1, 1);
+    }
+  }
+  command_buffer.CmdVkCopyBufferToImage(scratch.buffer(), texture.image(),
+                                        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region_count,
+                                        regions);
+  bool range_known = false;
+  for (const auto& range : direct_resolve_ranges_) {
+    if (range.first == range_start && range.second == range_length) {
+      range_known = true;
+      break;
+    }
+  }
+  if (!range_known) {
+    direct_resolve_ranges_.emplace_back(range_start, range_length);
+  }
+  InvalidateRangeExcept(texture, range_start, range_length);
+  ++direct_resolve_stats_[0];
+  if (own_scale_sixteenths) {
+    SetOwnScaleBase(dest_base, own_scale_sixteenths);
+    ++own_scale_resolve_count_;
+    if (command_processor_.IsGpuTimingSequenceActive()) {
+      command_processor_.GpuTimingSequence(fmt::format(
+          "own-scale resolve {:08X} {}x{} at {}/16 ({})", dest_base, key.GetWidth(),
+          key.GetHeight(), own_scale_sixteenths,
+          is_depth ? "depth" : "red/blue swapped"));
+    }
+  }
+  return true;
+}
+
+bool VulkanTextureCache::EnsureDepthFloat24Pass() {
+  if (depth_float24_pass_pipeline_ != VK_NULL_HANDLE) {
+    return true;
+  }
+  if (depth_float24_pass_tried_) {
+    return false;
+  }
+  depth_float24_pass_tried_ = true;
+  // Float32To20e4 and Float20e4To32 from xenos.cpp.
+  static const char kSource[] = R"(#version 450
+layout(local_size_x = 64) in;
+layout(push_constant) uniform Constants {
+  uint texel_count;
+  uint round_to_nearest_even;
+  // 0: depth through float24 (k_24_8_FLOAT); 1: red/blue swap; 2: depth as the unorm24 of its
+  // float24 bits (k_24_8 sampled from a float24 depth resolve); 3: unorm24 depth kept as
+  // float32, rounded to 24 bits (k_24_8); 4: D24 unorm words (k_24_8).
+  uint mode;
+} constants;
+layout(set = 0, binding = 0, std430) buffer Texels { uint texels[]; };
+uint ToFloat24(uint u) {
+  if (!(uintBitsToFloat(u) > 0.0)) {
+    return 0u;
+  }
+  if (u >= 0x3FFFFFF8u) {
+    return 0xFFFFFFu;
+  }
+  if (u < 0x38800000u) {
+    uint shift = min(113u - (u >> 23u), 24u);
+    u = (0x800000u | (u & 0x7FFFFFu)) >> shift;
+  } else {
+    u += 0xC8000000u;
+  }
+  if (constants.round_to_nearest_even != 0u) {
+    u += 3u + ((u >> 3u) & 1u);
+  }
