+uint32_t VulkanRenderTargetCache::PredictDrawOwnScaleSixteenths(
+    reg::RB_DEPTHCONTROL normalized_depth_control) const {
+  if (!main_pass_scale_sixteenths() || GetPath() != Path::kHostRenderTargets) {
+    return 0;
+  }
+  const RegisterFile& regs = register_file();
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  RenderTargetKey key;
+  key.pitch_tiles_at_32bpp =
+      ((rb_surface_info.surface_pitch
+        << uint32_t(rb_surface_info.msaa_samples >= xenos::MsaaSamples::k4X)) +
+       (xenos::kEdramTileWidthSamples - 1)) /
+      xenos::kEdramTileWidthSamples;
+  key.msaa_samples = rb_surface_info.msaa_samples;
+  uint32_t own_scale = main_pass_scale_sixteenths();
+  bool any = false;
+  if (normalized_depth_control.z_enable || normalized_depth_control.stencil_enable) {
+    auto rb_depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+    key.is_depth = 1;
+    key.base_tiles = rb_depth_info.depth_base;
+    key.resource_format = uint32_t(rb_depth_info.depth_format);
+    if (GetOwnScaleForKey(key) != own_scale) {
+      return 0;
+    }
+    any = true;
+  }
+  const uint32_t color_mask = regs.values[XE_GPU_REG_RB_COLOR_MASK];
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!((color_mask >> (4 * i)) & 0b1111)) {
+      continue;
+    }
+    auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    key.is_depth = 0;
+    key.base_tiles = color_info.color_base;
+    key.resource_format = uint32_t(xenos::GetStorageColorFormat(color_info.color_format));
+    if (GetOwnScaleForKey(key) != own_scale) {
+      return 0;
+    }
+    any = true;
+  }
+  return any ? own_scale : 0;
+}
+
+uint8_t VulkanRenderTargetCache::GetOwnScaleFormatFlags(RenderTargetKey key) const {
+  uint8_t& flags = own_scale_format_flags_[key.is_depth][key.resource_format & 15];
+  if (flags & kOwnScaleFormatQueried) {
+    return flags;
+  }
+  flags = kOwnScaleFormatQueried;
+  const VkFormat format = key.is_depth ? GetDepthVulkanFormat(key.GetDepthFormat())
+                                       : GetColorVulkanFormat(key.GetColorFormat());
+  if (format == VK_FORMAT_UNDEFINED) {
+    return flags;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+  VkFormatProperties properties;
+  ifn.vkGetPhysicalDeviceFormatProperties(vulkan_device->physical_device(), format, &properties);
+  constexpr VkFormatFeatureFlags kBlitFeatures =
+      VK_FORMAT_FEATURE_BLIT_SRC_BIT | VK_FORMAT_FEATURE_BLIT_DST_BIT;
+  if (key.is_depth) {
+    // Copied by a draw (CopyDepthRenderTargetRectangles), stencil through FragStencilRefEXT.
+    if (vulkan_device->extensions().ext_EXT_shader_stencil_export) {
+      flags |= kOwnScaleFormatBlit;
+    }
+  } else if ((properties.optimalTilingFeatures & kBlitFeatures) == kBlitFeatures) {
+    flags |= kOwnScaleFormatBlit;
+  }
+  if (!key.is_depth &&
+      (properties.optimalTilingFeatures & VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT)) {
+    flags |= kOwnScaleFormatLinear;
+  }
+  REXGPU_INFO("native_main_pass_scale_sixteenths: {} format {} (Vulkan {}): blit {}, linear {}",
+              key.is_depth ? "depth" : "color", uint32_t(key.resource_format), uint32_t(format),
+              (flags & kOwnScaleFormatBlit) != 0, (flags & kOwnScaleFormatLinear) != 0);
+  return flags;
+}
+
+bool VulkanRenderTargetCache::IsOwnScaleSupported(RenderTargetKey key) const {
+  if (GetPath() != Path::kHostRenderTargets || !key.own_scale_sixteenths ||
+      key.msaa_samples != xenos::MsaaSamples::k1X) {
+    return false;
+  }
+  if (key.GetWidth() * key.own_scale_sixteenths / 16 > GetMaxRenderTargetWidth() ||
+      GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples) *
+              key.own_scale_sixteenths / 16 >
+          GetMaxRenderTargetHeight()) {
+    return false;
+  }
+  return (GetOwnScaleFormatFlags(key) & kOwnScaleFormatBlit) != 0;
+}
+
+RenderTargetCache::RenderTarget* VulkanRenderTargetCache::GetUnscaledTwin(
+    RenderTarget* render_target) {
+  RenderTargetKey key = render_target->key();
+  if (!key.own_scale_sixteenths) {
+    return render_target;
+  }
+  key.own_scale_sixteenths = 0;
+  return GetOrCreateRenderTarget(key);
+}
+
+void VulkanRenderTargetCache::BlitRenderTargetRectangles(RenderTarget* source, RenderTarget* dest,
+                                                         const Transfer::Rectangle* rectangles,
+                                                         uint32_t rectangle_count) {
+  if (!rectangle_count || source == dest) {
+    return;
+  }
+  if (source->key().is_depth) {
+    CopyDepthRenderTargetRectangles(source, dest, rectangles, rectangle_count);
+    return;
+  }
+  auto& source_rt = *static_cast<VulkanRenderTarget*>(source);
+  auto& dest_rt = *static_cast<VulkanRenderTarget*>(dest);
+  const RenderTargetKey source_key = source_rt.key();
+  const RenderTargetKey dest_key = dest_rt.key();
+  const VkImageAspectFlags aspect =
+      source_key.is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                          : VK_IMAGE_ASPECT_COLOR_BIT;
+  command_processor_.PushImageMemoryBarrier(
+      source_rt.image(), ui::vulkan::util::InitializeSubresourceRange(aspect),
+      source_rt.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      source_rt.current_access_mask(), VK_ACCESS_TRANSFER_READ_BIT, source_rt.current_layout(),
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  source_rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                     VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.PushImageMemoryBarrier(
+      dest_rt.image(), ui::vulkan::util::InitializeSubresourceRange(aspect),
+      dest_rt.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT, dest_rt.current_access_mask(),
+      VK_ACCESS_TRANSFER_WRITE_BIT, dest_rt.current_layout(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  dest_rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  const uint32_t source_scale_x = GetKeyScaleXSixteenths(source_key);
+  const uint32_t source_scale_y = GetKeyScaleYSixteenths(source_key);
+  const uint32_t dest_scale_x = GetKeyScaleXSixteenths(dest_key);
+  const uint32_t dest_scale_y = GetKeyScaleYSixteenths(dest_key);
+  const VkFilter filter =
+      (!source_key.is_depth && (GetOwnScaleFormatFlags(source_key) & kOwnScaleFormatLinear))
+          ? VK_FILTER_LINEAR
+          : VK_FILTER_NEAREST;
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  for (uint32_t i = 0; i < rectangle_count; ++i) {
+    const Transfer::Rectangle& rectangle = rectangles[i];
+    if (!rectangle.width_pixels || !rectangle.height_pixels) {
+      continue;
+    }
+    VkImageBlit region;
+    region.srcSubresource.aspectMask = aspect;
+    region.srcSubresource.mipLevel = 0;
+    region.srcSubresource.baseArrayLayer = 0;
+    region.srcSubresource.layerCount = 1;
+    region.dstSubresource = region.srcSubresource;
+    const uint32_t x1 = rectangle.x_pixels + rectangle.width_pixels;
+    const uint32_t y1 = rectangle.y_pixels + rectangle.height_pixels;
+    region.srcOffsets[0].x = int32_t(rectangle.x_pixels * source_scale_x / 16);
+    region.srcOffsets[0].y = int32_t(rectangle.y_pixels * source_scale_y / 16);
+    region.srcOffsets[0].z = 0;
+    region.srcOffsets[1].x = int32_t(x1 * source_scale_x / 16);
+    region.srcOffsets[1].y = int32_t(y1 * source_scale_y / 16);
+    region.srcOffsets[1].z = 1;
+    region.dstOffsets[0].x = int32_t(rectangle.x_pixels * dest_scale_x / 16);
+    region.dstOffsets[0].y = int32_t(rectangle.y_pixels * dest_scale_y / 16);
+    region.dstOffsets[0].z = 0;
+    region.dstOffsets[1].x = int32_t(x1 * dest_scale_x / 16);
+    region.dstOffsets[1].y = int32_t(y1 * dest_scale_y / 16);
+    region.dstOffsets[1].z = 1;
+    command_buffer.CmdVkBlitImage(source_rt.image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                  dest_rt.image(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region,
+                                  filter);
+  }
+  if (command_processor_.IsGpuTimingSequenceActive()) {
+    command_processor_.GpuTimingSequence(
+        fmt::format("own scale blit {} -> {}, {} rectangles", source_key.GetDebugName(),
+                    dest_key.GetDebugName(), rectangle_count));
+  }
+}
+
+VkPipeline VulkanRenderTargetCache::GetOwnScaleDepthCopyPipeline(
+    xenos::DepthRenderTargetFormat format, uint32_t source_scale_sixteenths,
+    uint32_t dest_scale_sixteenths) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const bool use_dynamic_rendering =
+      REXCVAR_GET(vulkan_dynamic_rendering) && vulkan_device->properties().dynamicRendering;
+  const uint32_t pipeline_key = uint32_t(format) | (source_scale_sixteenths << 4) |
+                                (dest_scale_sixteenths << 14) |
+                                (uint32_t(use_dynamic_rendering) << 24);
+  auto it = own_scale_depth_copy_pipelines_.find(pipeline_key);
+  if (it != own_scale_depth_copy_pipelines_.end()) {
+    return it->second;
+  }
+  own_scale_depth_copy_pipelines_.emplace(pipeline_key, VK_NULL_HANDLE);
+
+  if (own_scale_depth_copy_pipeline_layout_ == VK_NULL_HANDLE) {
+    VkPipelineLayoutCreateInfo layout_create_info = {};
+    layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_create_info.setLayoutCount = 1;
+    layout_create_info.pSetLayouts = &descriptor_set_layout_sampled_image_x2_;
+    if (dfn.vkCreatePipelineLayout(device, &layout_create_info, nullptr,
+                                   &own_scale_depth_copy_pipeline_layout_) != VK_SUCCESS) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the own scale depth copy layout");
+      own_scale_depth_copy_pipeline_layout_ = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+    }
+  }
+
+  // Fragment shader: the source texel under the destination pixel center.
+  SpirvBuilder builder(spv::Spv_1_0, (SpirvShaderTranslator::kSpirvMagicToolId << 16) | 1, nullptr);
+  builder.addCapability(spv::CapabilityShader);
+  builder.addExtension("SPV_EXT_shader_stencil_export");
+  builder.addCapability(spv::CapabilityStencilExportEXT);
+  builder.setMemoryModel(spv::AddressingModelLogical, spv::MemoryModelGLSL450);
+  builder.setSource(spv::SourceLanguageUnknown, 0);
+  spv::Id type_void = builder.makeVoidType();
+  spv::Id type_int = builder.makeIntType(32);
+  spv::Id type_int2 = builder.makeVectorType(type_int, 2);
+  spv::Id type_uint = builder.makeUintType(32);
+  spv::Id type_uint4 = builder.makeVectorType(type_uint, 4);
+  spv::Id type_float = builder.makeFloatType(32);
+  spv::Id type_float2 = builder.makeVectorType(type_float, 2);
+  spv::Id type_float4 = builder.makeVectorType(type_float, 4);
+  std::vector<spv::Id> main_interface;
+  spv::Id output_depth =
+      builder.createVariable(spv::NoPrecision, spv::StorageClassOutput, type_float, "gl_FragDepth");
+  builder.addDecoration(output_depth, spv::DecorationBuiltIn, spv::BuiltInFragDepth);
+  main_interface.push_back(output_depth);
+  spv::Id output_stencil = builder.createVariable(spv::NoPrecision, spv::StorageClassOutput,
+                                                  type_int, "gl_FragStencilRefARB");
+  builder.addDecoration(output_stencil, spv::DecorationBuiltIn, spv::BuiltInFragStencilRefEXT);
+  main_interface.push_back(output_stencil);
+  spv::Id input_fragment_coord =
+      builder.createVariable(spv::NoPrecision, spv::StorageClassInput, type_float4, "gl_FragCoord");
+  builder.addDecoration(input_fragment_coord, spv::DecorationBuiltIn, spv::BuiltInFragCoord);
+  main_interface.push_back(input_fragment_coord);
+  spv::Id source_depth_texture = builder.createVariable(
+      spv::NoPrecision, spv::StorageClassUniformConstant,
+      builder.makeImageType(type_float, spv::Dim2D, false, false, false, 1,
+                            spv::ImageFormatUnknown),
+      "xe_own_scale_depth");
+  builder.addDecoration(source_depth_texture, spv::DecorationDescriptorSet, 0);
+  builder.addDecoration(source_depth_texture, spv::DecorationBinding, 0);
+  spv::Id source_stencil_texture = builder.createVariable(
+      spv::NoPrecision, spv::StorageClassUniformConstant,
+      builder.makeImageType(type_uint, spv::Dim2D, false, false, false, 1, spv::ImageFormatUnknown),
+      "xe_own_scale_stencil");
+  builder.addDecoration(source_stencil_texture, spv::DecorationDescriptorSet, 0);
+  builder.addDecoration(source_stencil_texture, spv::DecorationBinding, 1);
+  std::vector<spv::Id> main_param_types;
+  std::vector<std::vector<spv::Decoration>> main_precisions;
+  spv::Block* main_entry;
+  spv::Function* main_function = builder.makeFunctionEntry(
+      spv::NoPrecision, type_void, "main", main_param_types, main_precisions, &main_entry);
+  std::vector<unsigned int> swizzle_xy = {0, 1};
+  spv::Id fragment_xy = builder.createRvalueSwizzle(
+      spv::NoPrecision, type_float2, builder.createLoad(input_fragment_coord, spv::NoPrecision),
+      swizzle_xy);
+  spv::Id source_xy = builder.createUnaryOp(
+      spv::OpConvertFToS, type_int2,
+      builder.createBinOp(spv::OpVectorTimesScalar, type_float2, fragment_xy,
+                          builder.makeFloatConstant(float(source_scale_sixteenths) /
+                                                    float(dest_scale_sixteenths))));
+  spv::Builder::TextureParameters texture_parameters = {};
+  texture_parameters.coords = source_xy;
+  texture_parameters.lod = builder.makeIntConstant(0);
+  texture_parameters.sampler = builder.createLoad(source_depth_texture, spv::NoPrecision);
+  builder.createStore(
+      builder.createCompositeExtract(
+          builder.createTextureCall(spv::NoPrecision, type_float4, false, true, false, false, false,
+                                    texture_parameters, spv::ImageOperandsMaskNone),
+          type_float, 0),
+      output_depth);
+  texture_parameters.sampler = builder.createLoad(source_stencil_texture, spv::NoPrecision);
+  builder.createStore(
+      builder.createUnaryOp(
+          spv::OpBitcast, type_int,
+          builder.createCompositeExtract(
+              builder.createTextureCall(spv::NoPrecision, type_uint4, false, true, false, false,
+                                        false, texture_parameters, spv::ImageOperandsMaskNone),
+              type_uint, 0)),
+      output_stencil);
+  builder.leaveFunction();
+  builder.addExecutionMode(main_function, spv::ExecutionModeOriginUpperLeft);
+  builder.addExecutionMode(main_function, spv::ExecutionModeDepthReplacing);
+  builder.addExecutionMode(main_function, spv::ExecutionModeStencilRefReplacingEXT);
+  spv::Instruction* entry_point =
+      builder.addEntryPoint(spv::ExecutionModelFragment, main_function, "main");
+  for (spv::Id interface_id : main_interface) {
+    entry_point->addIdOperand(interface_id);
+  }
+  std::vector<unsigned int> shader_code;
+  builder.dump(shader_code);
+  VkShaderModule fragment_shader = ui::vulkan::util::CreateShaderModule(
+      vulkan_device, reinterpret_cast<const uint32_t*>(shader_code.data()),
+      sizeof(uint32_t) * shader_code.size());
+  if (fragment_shader == VK_NULL_HANDLE) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the own scale depth copy shader");
+    return VK_NULL_HANDLE;
+  }
+
+  RenderPassKey render_pass_key;
+  render_pass_key.msaa_samples = xenos::MsaaSamples::k1X;
+  render_pass_key.depth_and_color_used = 0b1;
+  render_pass_key.depth_format = format;
+  VkRenderPass render_pass = VK_NULL_HANDLE;
+  if (!use_dynamic_rendering) {
+    render_pass = GetHostRenderTargetsRenderPass(render_pass_key);
+    if (render_pass == VK_NULL_HANDLE) {
+      dfn.vkDestroyShaderModule(device, fragment_shader, nullptr);
+      return VK_NULL_HANDLE;
+    }
+  }
+
+  VkPipelineShaderStageCreateInfo shader_stages[2] = {};
+  shader_stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  shader_stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+  shader_stages[0].module = transfer_passthrough_vertex_shader_;
+  shader_stages[0].pName = "main";
+  shader_stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  shader_stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+  shader_stages[1].module = fragment_shader;
+  shader_stages[1].pName = "main";
+  VkVertexInputBindingDescription vertex_input_binding;
+  vertex_input_binding.binding = 0;
+  vertex_input_binding.stride = sizeof(float) * 2;
+  vertex_input_binding.inputRate = VK_VERTEX_INPUT_RATE_VERTEX;
+  VkVertexInputAttributeDescription vertex_input_attribute;
+  vertex_input_attribute.location = 0;
+  vertex_input_attribute.binding = 0;
+  vertex_input_attribute.format = VK_FORMAT_R32G32_SFLOAT;
+  vertex_input_attribute.offset = 0;
+  VkPipelineVertexInputStateCreateInfo vertex_input_state = {};
+  vertex_input_state.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+  vertex_input_state.vertexBindingDescriptionCount = 1;
+  vertex_input_state.pVertexBindingDescriptions = &vertex_input_binding;
+  vertex_input_state.vertexAttributeDescriptionCount = 1;
+  vertex_input_state.pVertexAttributeDescriptions = &vertex_input_attribute;
+  VkPipelineInputAssemblyStateCreateInfo input_assembly_state = {};
+  input_assembly_state.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+  input_assembly_state.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+  VkPipelineViewportStateCreateInfo viewport_state = {};
+  viewport_state.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+  viewport_state.viewportCount = 1;
+  viewport_state.scissorCount = 1;
+  VkPipelineRasterizationStateCreateInfo rasterization_state = {};
+  rasterization_state.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+  rasterization_state.polygonMode = VK_POLYGON_MODE_FILL;
+  rasterization_state.cullMode = VK_CULL_MODE_NONE;
+  rasterization_state.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+  rasterization_state.lineWidth = 1.0f;
+  VkPipelineMultisampleStateCreateInfo multisample_state = {};
+  multisample_state.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+  multisample_state.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+  VkPipelineDepthStencilStateCreateInfo depth_stencil_state = {};
+  depth_stencil_state.sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
+  depth_stencil_state.depthTestEnable = VK_TRUE;
+  depth_stencil_state.depthWriteEnable = VK_TRUE;
+  depth_stencil_state.depthCompareOp = VK_COMPARE_OP_ALWAYS;
+  depth_stencil_state.stencilTestEnable = VK_TRUE;
+  depth_stencil_state.front.failOp = VK_STENCIL_OP_REPLACE;
+  depth_stencil_state.front.passOp = VK_STENCIL_OP_REPLACE;
+  depth_stencil_state.front.depthFailOp = VK_STENCIL_OP_REPLACE;
+  depth_stencil_state.front.compareOp = VK_COMPARE_OP_ALWAYS;
+  depth_stencil_state.front.compareMask = UINT8_MAX;
+  depth_stencil_state.front.writeMask = UINT8_MAX;
+  depth_stencil_state.front.reference = UINT8_MAX;
+  depth_stencil_state.back = depth_stencil_state.front;
+  VkPipelineColorBlendStateCreateInfo color_blend_state = {};
+  color_blend_state.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+  VkDynamicState dynamic_states[] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+  VkPipelineDynamicStateCreateInfo dynamic_state = {};
+  dynamic_state.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+  dynamic_state.dynamicStateCount = uint32_t(rex::countof(dynamic_states));
+  dynamic_state.pDynamicStates = dynamic_states;
+  VkPipelineRenderingCreateInfo pipeline_rendering_create_info = {};
+  pipeline_rendering_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO;
+  pipeline_rendering_create_info.depthAttachmentFormat = GetDepthVulkanFormat(format);
+  pipeline_rendering_create_info.stencilAttachmentFormat =
+      pipeline_rendering_create_info.depthAttachmentFormat;
+  VkGraphicsPipelineCreateInfo pipeline_create_info = {};
+  pipeline_create_info.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+  pipeline_create_info.pNext = use_dynamic_rendering ? &pipeline_rendering_create_info : nullptr;
+  pipeline_create_info.stageCount = 2;
+  pipeline_create_info.pStages = shader_stages;
+  pipeline_create_info.pVertexInputState = &vertex_input_state;
+  pipeline_create_info.pInputAssemblyState = &input_assembly_state;
+  pipeline_create_info.pViewportState = &viewport_state;
+  pipeline_create_info.pRasterizationState = &rasterization_state;
+  pipeline_create_info.pMultisampleState = &multisample_state;
+  pipeline_create_info.pDepthStencilState = &depth_stencil_state;
+  pipeline_create_info.pColorBlendState = &color_blend_state;
+  pipeline_create_info.pDynamicState = &dynamic_state;
+  pipeline_create_info.layout = own_scale_depth_copy_pipeline_layout_;
+  pipeline_create_info.renderPass = render_pass;
+  pipeline_create_info.basePipelineIndex = -1;
+  VkPipeline pipeline;
+  VkResult result = dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_create_info,
+                                                  nullptr, &pipeline);
+  dfn.vkDestroyShaderModule(device, fragment_shader, nullptr);
+  if (result != VK_SUCCESS) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the own scale depth copy pipeline");
+    return VK_NULL_HANDLE;
+  }
+  own_scale_depth_copy_pipelines_[pipeline_key] = pipeline;
+  return pipeline;
+}
