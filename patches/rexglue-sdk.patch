+void MultiplyMatrices4x4(const double a[4][4], const double b[4][4], double product_out[4][4]) {
+  for (uint32_t i = 0; i < 4; ++i) {
+    for (uint32_t j = 0; j < 4; ++j) {
+      double sum = 0.0;
+      for (uint32_t k = 0; k < 4; ++k) {
+        sum += a[i][k] * b[k][j];
+      }
+      product_out[i][j] = sum;
+    }
+  }
+}
