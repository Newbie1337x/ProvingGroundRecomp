+    info.coordinate_info.width_div_8 = uint32_t(rect[2] - rect[0]) >> 3;
+    info.coordinate_info.draw_resolution_scale_x = clear_scale_x;
+    info.coordinate_info.draw_resolution_scale_y = clear_scale_y;
+    info.height_div_8 = uint32_t(rect[3] - rect[1]) >> 3;
+    info.depth_edram_info.base_tiles = depth_base + base_offset_tiles;
+    info.color_edram_info.base_tiles =
