+bool PrimitiveProcessor::ProcessStaticResetIndices16(uint32_t base, uint32_t count,
+                                                     uint32_t bytes,
+                                                     uint32_t reset_index_guest_endian,
+                                                     CachedResult& result) {
+  if (!REXCVAR_GET(gpu_trust_native_ranges) || !native_ranges::Count()) {
+    return false;
+  }
+  const uint64_t key = (uint64_t(base) << 32) | count;
+  const uint32_t removal_version = native_ranges::RemovalVersion();
+  auto it = static_index_entries_.find(key);
+  uint32_t generation;
+  if (it != static_index_entries_.end() && it->second.removal_version == removal_version) {
+    // Nothing was replaced since the range was found.
+    generation = it->second.generation;
+  } else {
+    generation = native_ranges::Lookup(base, bytes);
+    if (!generation) {
+      return false;
+    }
+    if (it != static_index_entries_.end() && it->second.generation == generation) {
+      it->second.removal_version = removal_version;
+    }
+  }
+  if (it == static_index_entries_.end() || it->second.generation != generation ||
+      it->second.reset_index_guest_endian != reset_index_guest_endian) {
+    StaticIndexEntry entry;
+    entry.generation = generation;
+    entry.removal_version = removal_version;
+    entry.reset_index_guest_endian = reset_index_guest_endian;
+    entry.result = result;
+    entry.persistent_handle = SIZE_MAX;
+    auto guest_indices = memory_.TranslatePhysical<const uint16_t*>(base);
+    bool is_reset_index_used, is_ffff_used_as_vertex_index;
+    Get16BitResetIndexUsage(guest_indices, count, reset_index_guest_endian, is_reset_index_used,
+                            is_ffff_used_as_vertex_index);
+    if (is_reset_index_used) {
+      entry.result.index_buffer_type = ProcessedIndexBufferType::kHostConverted;
+      entry.result.host_index_format =
+          is_ffff_used_as_vertex_index ? xenos::IndexFormat::kInt32 : xenos::IndexFormat::kInt16;
+      void* host_indices = RequestPersistentConvertedIndexBuffer(
+          entry.result.host_index_format, count, base, entry.persistent_handle);
+      if (!host_indices) {
+        return false;
+      }
+      if (is_ffff_used_as_vertex_index) {
+        ReplaceResetIndex16To24(reinterpret_cast<uint32_t*>(host_indices), guest_indices, count,
+                                reset_index_guest_endian);
+      } else {
+        ReplaceResetIndex16To16(reinterpret_cast<uint16_t*>(host_indices), guest_indices, count,
+                                reset_index_guest_endian);
+      }
+    }
+    it = static_index_entries_.insert_or_assign(key, entry).first;
+  }
+  CachedResult found = it->second.result;
+  if (found.index_buffer_type == ProcessedIndexBufferType::kHostConverted) {
+    found.host_index_buffer_handle =
+        UsePersistentConvertedIndexBuffer(it->second.persistent_handle);
+    if (found.host_index_buffer_handle == SIZE_MAX) {
+      return false;
+    }
+  }
+  result = found;
+  return true;
+}
