+void VulkanCommandProcessor::LogStateCensus() {
+  static uint64_t last[4] = {};
+  const double frames = double(draw_section_frames_);
+  const uint64_t same = state_census_[0] - last[0], different = state_census_[1] - last[1],
+                 first = state_census_[2] - last[2], draws = state_census_[3] - last[3];
+  std::copy(std::begin(state_census_), std::end(state_census_), last);
+  const uint64_t known = same + different;
+  REXGPU_INFO("  state census per frame: {:.1f} draws; known mesh draws {:.1f} with the same "
+              "state hash as the item's last draw ({:.1f}%), {:.1f} different, {:.1f} first",
+              draws / frames, same / frames, known ? 100.0 * same / known : 0.0,
+              different / frames, first / frames);
+  if (!state_diff_counts_.empty()) {
+    std::vector<std::pair<uint32_t, uint32_t>> diffs;
+    for (uint32_t i = 0; i < state_diff_counts_.size(); ++i) {
+      if (state_diff_counts_[i]) {
+        diffs.emplace_back(state_diff_counts_[i], i);
+      }
+    }
+    std::sort(diffs.begin(), diffs.end(), std::greater<>());
+    std::string diff_line;
+    for (size_t i = 0; i < std::min<size_t>(diffs.size(), 40); ++i) {
+      const RegisterInfo* info = RegisterFile::GetRegisterInfo(diffs[i].second);
+      diff_line += fmt::format(" {:04X} {} {};", diffs[i].second,
+                               info && info->name ? info->name : "?", diffs[i].first);
+    }
+    REXGPU_INFO("  registers differing between draws of the same item (sampled):{}", diff_line);
+    std::fill(state_diff_counts_.begin(), state_diff_counts_.end(), 0);
+  }
+  if (state_churn_.empty()) {
+    return;
+  }
+  std::vector<std::pair<uint32_t, uint32_t>> top;
+  for (uint32_t i = 0; i < state_churn_.size(); ++i) {
+    if (state_churn_[i]) {
+      top.emplace_back(state_churn_[i], i);
+    }
+  }
+  std::sort(top.begin(), top.end(), std::greater<>());
+  std::string line;
+  for (size_t i = 0; i < std::min<size_t>(top.size(), 30); ++i) {
+    const RegisterInfo* info = RegisterFile::GetRegisterInfo(top[i].second);
+    line += fmt::format(" {:04X} {} {:.1f};", top[i].second,
+                        info && info->name ? info->name : "?", top[i].first / frames);
+  }
+  REXGPU_INFO("  registers changed per frame (most first):{}", line);
+  std::fill(state_churn_.begin(), state_churn_.end(), 0);
+}
+
+void VulkanCommandProcessor::MakeFloatConstantRuns(
+    const uint64_t* map, std::vector<std::pair<uint32_t, uint32_t>>& runs_out) {
+  runs_out.clear();
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t bits = map[i];
+    uint32_t index;
+    while (rex::bit_scan_forward(bits, &index)) {
+      bits &= ~(UINT64_C(1) << index);
+      uint32_t constant = i * 64 + index;
+      if (!runs_out.empty() && runs_out.back().first + runs_out.back().second == constant) {
+        ++runs_out.back().second;
+      } else {
+        runs_out.emplace_back(constant, 1);
+      }
+    }
+  }
+}
