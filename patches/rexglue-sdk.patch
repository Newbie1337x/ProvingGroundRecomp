diff --git a/src/system/native_ranges.cpp b/src/system/native_ranges.cpp
new file mode 100644
index 0000000..488ab60
--- /dev/null
+++ b/src/system/native_ranges.cpp
@@ -0,0 +1,159 @@
+#include <rex/graphics/native_ranges.h>
+
+#include <algorithm>
+#include <cstring>
+#include <atomic>
+#include <map>
+#include <unordered_map>
+#include <shared_mutex>
+
+namespace rex::graphics::native_ranges {
+
+namespace {
+struct Range {
+  uint64_t end;
+  uint32_t generation;
+  bool is_index;
+};
+// Dirty marks by generation (wrapping: a generation 2^20 registrations old shares a mark with a
+// new one, which can only cause an extra request).
+constexpr uint32_t kDirtySlots = uint32_t(1) << 20;
+std::atomic<uint8_t> g_dirty[kDirtySlots];
+std::shared_mutex g_mutex;
+// By start; ranges do not overlap.
+std::map<uint32_t, Range> g_ranges;
+// The same ranges by start, for the common lookup of a whole buffer.
+std::unordered_map<uint32_t, Range> g_by_start;
+uint32_t g_generation = 0;
+std::atomic<uint32_t> g_count{0};
+// Pages (4 KB) of the 512 MB of physical memory that any registered range ever touched; never
+// cleared, so a clear bit means no range can contain an address in that page.
+constexpr uint32_t kPageShift = 12;
+constexpr uint32_t kPageCount = (uint32_t(1) << 29) >> kPageShift;
+std::atomic<uint64_t> g_pages[kPageCount / 64];
+
+void MarkPages(uint32_t start, uint64_t end) {
+  uint64_t last = std::min<uint64_t>(end - 1, (uint64_t(1) << 29) - 1);
+  for (uint64_t page = start >> kPageShift; page <= (last >> kPageShift); ++page) {
+    g_pages[page >> 6].fetch_or(uint64_t(1) << (page & 63), std::memory_order_relaxed);
+  }
+}
+std::atomic<uint32_t> g_removal_version{0};
+std::atomic<uint32_t> g_change_version{0};
+
+void EraseOverlapping(uint32_t start, uint64_t end) {
+  auto it = g_ranges.upper_bound(start);
+  if (it != g_ranges.begin() && std::prev(it)->second.end > start) --it;
+  bool erased = false;
+  while (it != g_ranges.end() && it->first < end) {
+    g_by_start.erase(it->first);
+    it = g_ranges.erase(it);
+    erased = true;
+  }
+  if (erased) g_removal_version.fetch_add(1, std::memory_order_release);
+  g_change_version.fetch_add(1, std::memory_order_release);
+}
+}  // namespace
+
+void Register(uint32_t start, uint32_t length, bool is_index) {
+  if (!length) return;
+  std::unique_lock lock(g_mutex);
+  uint64_t end = uint64_t(start) + length;
+  EraseOverlapping(start, end);
+  if (!++g_generation) ++g_generation;
+  g_dirty[g_generation & (kDirtySlots - 1)].store(0, std::memory_order_relaxed);
+  g_ranges.emplace(start, Range{end, g_generation, is_index});
+  g_by_start.emplace(start, Range{end, g_generation, is_index});
+  MarkPages(start, end);
+  g_count.store(uint32_t(g_ranges.size()), std::memory_order_relaxed);
+}
+
+void Unregister(uint32_t start, uint32_t length) {
+  std::unique_lock lock(g_mutex);
+  EraseOverlapping(start, uint64_t(start) + length);
+  g_count.store(uint32_t(g_ranges.size()), std::memory_order_relaxed);
+}
+
+std::atomic<uint64_t> g_invalidations[2];
+uint32_t g_invalidation_samples[16][2];
+std::atomic<uint32_t> g_invalidation_sample_index{0};
+
+void GetInvalidationStats(uint64_t counts_out[2], uint32_t samples_out[16][2]) {
+  counts_out[0] = g_invalidations[0].load();
+  counts_out[1] = g_invalidations[1].load();
+  std::memcpy(samples_out, g_invalidation_samples, sizeof(g_invalidation_samples));
+}
+
+void InvalidateWritten(uint32_t start, uint32_t length, bool exact) {
+  if (!length || !g_count.load(std::memory_order_relaxed) || start >= (uint32_t(1) << 29)) return;
+  const uint64_t last = std::min<uint64_t>(uint64_t(start) + length - 1, (uint64_t(1) << 29) - 1);
+  bool any = false;
+  for (uint64_t page = start >> kPageShift; page <= (last >> kPageShift); ++page) {
+    if (g_pages[page >> 6].load(std::memory_order_relaxed) & (uint64_t(1) << (page & 63))) {
+      any = true;
+      break;
+    }
+  }
+  if (!any) return;
+  std::unique_lock lock(g_mutex);
+  auto it = g_ranges.upper_bound(start);
+  if (it != g_ranges.begin() && std::prev(it)->second.end > start) --it;
+  bool erased = false;
+  while (it != g_ranges.end() && it->first <= last) {
+    if (it->second.end <= start) {
+      ++it;
+      continue;
+    }
+    g_invalidations[exact ? 1 : 0].fetch_add(1);
+    const uint32_t sample = g_invalidation_sample_index.fetch_add(1) & 15;
+    g_invalidation_samples[sample][0] = start;
+    g_invalidation_samples[sample][1] = it->first | uint32_t(it->second.is_index) << 31;
+    if (it->second.is_index) {
+      g_by_start.erase(it->first);
+      it = g_ranges.erase(it);
+      erased = true;
+    } else {
+      g_dirty[it->second.generation & (kDirtySlots - 1)].store(1, std::memory_order_release);
+      ++it;
+    }
+  }
+  if (erased) {
+    g_removal_version.fetch_add(1, std::memory_order_release);
+    g_change_version.fetch_add(1, std::memory_order_release);
+    g_count.store(uint32_t(g_ranges.size()), std::memory_order_relaxed);
+  }
+}
+
+bool IsDirty(uint32_t generation) {
+  return g_dirty[generation & (kDirtySlots - 1)].load(std::memory_order_acquire) != 0;
+}
+
+void ClearDirty(uint32_t generation) {
+  g_dirty[generation & (kDirtySlots - 1)].store(0, std::memory_order_release);
+}
+
+uint32_t Lookup(uint32_t start, uint32_t length) {
+  if (!g_count.load(std::memory_order_relaxed)) return 0;
+  if (start >= (uint32_t(1) << 29)) return 0;
+  {
+    const uint32_t page = start >> kPageShift;
+    if (!(g_pages[page >> 6].load(std::memory_order_relaxed) & (uint64_t(1) << (page & 63)))) {
+      return 0;
+    }
+  }
+  std::shared_lock lock(g_mutex);
+  auto exact = g_by_start.find(start);
+  if (exact != g_by_start.end()) {
+    return uint64_t(start) + length <= exact->second.end ? exact->second.generation : 0;
+  }
+  auto it = g_ranges.upper_bound(start);
+  if (it == g_ranges.begin()) return 0;
+  --it;
+  return uint64_t(start) + length <= it->second.end ? it->second.generation : 0;
+}
+
+uint32_t Count() { return g_count.load(std::memory_order_relaxed); }
+uint32_t RemovalVersion() { return g_removal_version.load(std::memory_order_acquire); }
+uint32_t ChangeVersion() { return g_change_version.load(std::memory_order_acquire); }
+
+}  // namespace rex::graphics::native_ranges
