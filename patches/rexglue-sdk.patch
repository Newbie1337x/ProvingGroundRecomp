+  kGpuFenceWait,   // command thread: blocking wait for a submission fence
+  kGpuSwap,        // command thread: IssueSwap
+  kGuestKick,      // guest moved the ring write pointer (instant)
+  kGuest0,         // free for the game's own hooks
