+void VulkanCommandProcessor::RecordNativeReplay(const VulkanShader* vertex_shader,
+                                                const VulkanShader* pixel_shader,
+                                                uint32_t used_texture_mask) {
+  constexpr size_t kMaxEntries = 32768;
+  if (native_replay_entries_.size() >= kMaxEntries) {
+    native_replay_entries_.clear();
+  }
+  const uint32_t counts[4] = {
+      uint32_t(vertex_shader->GetTextureBindingsAfterTranslation().size()),
+      uint32_t(vertex_shader->GetSamplerBindingsAfterTranslation().size()),
+      pixel_shader ? uint32_t(pixel_shader->GetTextureBindingsAfterTranslation().size()) : 0,
+      pixel_shader ? uint32_t(pixel_shader->GetSamplerBindingsAfterTranslation().size()) : 0};
+  // UpdateBindings wrote the stages it had anything for: vertex textures and samplers, then
+  // pixel ones.
+  if (descriptor_write_image_info_.size() != size_t(counts[0]) + counts[1] + counts[2] + counts[3] ||
+      current_samplers_vertex_.size() != counts[1] || current_samplers_pixel_.size() != counts[3]) {
+    return;
+  }
+  NativeReplayEntry& entry = native_replay_entries_[native_replay_key_];
+  entry.texture_sets[0] = entry.texture_sets[1] = VK_NULL_HANDLE;
+  entry.used_texture_mask = used_texture_mask;
+  entry.anisotropic_override = REXCVAR_GET(anisotropic_override);
+  entry.texture_generation = texture_cache_->texture_lookup_generation();
+  entry.resolve_generation = texture_cache_->scaled_resolve_generation();
+  const RegisterFile& regs = *register_file_;
+  entry.fetch.clear();
+  uint32_t mask = used_texture_mask, index;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    const uint32_t* dwords = &regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + index * 6];
+    entry.fetch.insert(entry.fetch.end(), dwords, dwords + 6);
+  }
+  texture_cache_->CaptureUsedTextures(used_texture_mask, entry.textures);
+  entry.sampler_handles.clear();
+  entry.sampler_generation = 0;
+  entry.samplers.assign(current_samplers_vertex_.begin(), current_samplers_vertex_.end());
+  entry.samplers.insert(entry.samplers.end(), current_samplers_pixel_.begin(),
+                        current_samplers_pixel_.end());
+  entry.samplers_submission = GetCurrentSubmission();
+  entry.image_info = descriptor_write_image_info_;
+  std::memcpy(entry.counts, counts, sizeof(counts));
+  entry.resolution_scaled = 0;
+  mask = used_texture_mask;
+  while (rex::bit_scan_forward(mask, &index)) {
+    mask &= ~(UINT32_C(1) << index);
+    entry.swizzled_signs[index] = texture_cache_->GetActiveTextureSwizzledSigns(index);
+    entry.host_swizzles[index] = uint16_t(texture_cache_->GetActiveTextureHostSwizzle(index));
+    entry.resolution_scaled |=
+        uint32_t(texture_cache_->IsActiveTextureResolutionScaled(index)) << index;
+  }
+  entry.fast_valid = false;
+  ++native_replay_stats_[1];
+}
+
+void VulkanCommandProcessor::ParseStateHashExclusions() {
+  state_hash_exclusions_parsed_ = true;
+  state_hash_excluded_.assign((RegisterFile::kRegisterCount + 63) / 64, 0);
+  std::string list = REXCVAR_GET(native_state_hash_exclude);
+  size_t pos = 0;
+  while (pos < list.size()) {
+    size_t end = list.find(',', pos);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    std::string item = list.substr(pos, end - pos);
+    pos = end + 1;
+    if (item.empty()) {
+      continue;
+    }
+    uint32_t index = uint32_t(std::strtoul(item.c_str(), nullptr, 16));
+    if (index < RegisterFile::kRegisterCount) {
+      state_hash_excluded_[index >> 6] |= UINT64_C(1) << (index & 63);
+    }
+  }
+  // Drop the excluded registers' current values from the hash.
+  for (uint32_t index = 0; index < RegisterFile::kRegisterCount; ++index) {
+    if ((state_hash_excluded_[index >> 6] & (UINT64_C(1) << (index & 63))) &&
+        register_file_->values[index]) {
+      state_hash_ ^= StateHashTerm(index, register_file_->values[index]) ^
+                     StateHashTerm(index, 0);
+    }
+  }
+}
