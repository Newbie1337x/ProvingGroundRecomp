+    PendingRenderTargetClear& pending = pending_rt_clear_;
+    // Same targets and values, same rows, side by side: one clear of both.
+    if (pending.info.rb_copy_control.value == info.rb_copy_control.value &&
+        pending.info.depth_edram_info.format == info.depth_edram_info.format &&
+        pending.info.color_edram_info.format == info.color_edram_info.format &&
+        pending.info.rb_depth_clear == info.rb_depth_clear && pending.pitch_tiles == pitch_tiles &&
+        pending.depth_base == depth_base && pending.color_base == color_base &&
+        pending.rect[1] == rect[1] && pending.rect[3] == rect[3] &&
+        (pending.rect[2] == rect[0] || rect[2] == pending.rect[0])) {
+      pending.rect[0] = std::min(pending.rect[0], rect[0]);
+      pending.rect[2] = std::max(pending.rect[2], rect[2]);
+      set_rectangle(pending.info, pending.rect, pitch_tiles, depth_base, color_base);
+      ++pending_rt_clear_merges_;
+      return true;
+    }
+    FlushPendingRenderTargetClear();
+  }
+  pending_rt_clear_.info = info;
+  std::copy(rect, rect + 4, pending_rt_clear_.rect);
+  pending_rt_clear_.pitch_tiles = pitch_tiles;
+  pending_rt_clear_.depth_base = depth_base;
+  pending_rt_clear_.color_base = color_base;
+  pending_rt_clear_valid_ = true;
+  return true;
+}
+
+void VulkanCommandProcessor::FlushPendingRenderTargetClear() {
+  if (!pending_rt_clear_valid_) {
+    return;
+  }
+  pending_rt_clear_valid_ = false;
+  if (!BeginSubmission(true)) {
+    return;
+  }
+  rt_update_memo_valid_ = false;
+  GpuTimingMark(GpuTimingCategory::kOther);
+  render_target_cache_->ClearHostRenderTargetsRectangle(pending_rt_clear_.info);
+  GpuTimingMark(GpuTimingCategory::kResolve);
+}
